    "tour_entries_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and passwords, everyday details, cards and secure notes. Add as many fields as you like to an entry; password fields stay hidden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap ve şifreler, gündelik bilgiler, kartlar ve güvenli notlar. Bir kayda istediğin kadar alan ekleyebilirsin; şifre alanları gizli durur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas y contraseñas, datos cotidianos, tarjetas y notas seguras. Añade a una entrada tantos campos como quieras; los campos de contraseña quedan ocultos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते और पासवर्ड, रोज़मर्रा की जानकारी, कार्ड और सुरक्षित नोट। किसी एंट्री में जितने चाहें उतने फ़ील्ड जोड़ें; पासवर्ड फ़ील्ड छिपे रहते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحسابات وكلمات المرور، والبيانات اليومية، والبطاقات، والملاحظات الآمنة. أضف إلى المدخلة ما تشاء من الحقول؛ وتبقى حقول كلمات المرور مخفية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号和密码、日常信息、银行卡和安全笔记。一个条目可添加任意多个字段；密码字段始终隐藏。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes et mots de passe, informations du quotidien, cartes et notes sécurisées. Ajoute autant de champs que tu veux à une entrée ; les champs de mot de passe restent masqués."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট ও পাসওয়ার্ড, দৈনন্দিন তথ্য, কার্ড এবং নিরাপদ নোট। একটি এন্ট্রিতে যত খুশি ফিল্ড যোগ করুন; পাসওয়ার্ড ফিল্ড লুকানো থাকে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e senhas, dados do dia a dia, cartões e notas seguras. Adicione quantos campos quiser a um item; os campos de senha ficam ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунты и пароли, повседневные данные, карты и защищённые заметки. Добавляйте в запись сколько угодно полей; поля паролей остаются скрытыми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹس اور پاس ورڈز، روزمرہ معلومات، کارڈز اور محفوظ نوٹس۔ کسی اندراج میں جتنی چاہیں فیلڈز شامل کریں؛ پاس ورڈ فیلڈز چھپی رہتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun dan kata sandi, data sehari-hari, kartu, dan catatan aman. Tambahkan kolom sebanyak yang kamu mau ke sebuah entri; kolom kata sandi tetap tersembunyi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Passwörter, Alltagsdaten, Karten und sichere Notizen. Füge einem Eintrag beliebig viele Felder hinzu; Passwortfelder bleiben verborgen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとパスワード、日常の情報、カード、セキュアメモ。1つのアイテムに好きなだけフィールドを追加でき、パスワードのフィールドは非表示のままです。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and passwords, everyday details, cards and secure notes. Add as many fields as you want to one entry; password fields go stay hidden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản và mật khẩu, thông tin hằng ngày, thẻ và ghi chú bảo mật. Thêm bao nhiêu trường tùy thích vào một mục; trường mật khẩu luôn được ẩn."
          }
        }
      }
    },
