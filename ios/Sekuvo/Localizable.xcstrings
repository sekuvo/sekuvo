    "vm_envelope_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The envelope opened but holds no entries — the fields may have been left empty on the sending side. Your vault is untouched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarf açıldı ama içinde kayıt yok — gönderen tarafta alanlar boş kalmış olabilir. Kasan olduğu gibi duruyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sobre se abrió pero no contiene entradas — puede que los campos se dejaran vacíos al enviarlo. Tu bóveda no se ha visto afectada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिफ़ाफ़ा खुला पर उसमें कोई एंट्री नहीं है — हो सकता है भेजने वाले ने फ़ील्ड ख़ाली छोड़ी हों। आपकी तिजोरी अप्रभावित है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُتح المظروف لكنه لا يحتوي على مدخلات — ربما تُركت الحقول فارغة عند الإرسال. خزنتك سليمة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信封已打开但不含任何条目 — 可能发送方把字段留空了。你的密码库未受影响。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enveloppe s'est ouverte mais ne contient aucune entrée — les champs ont peut-être été laissés vides côté envoi. Ton coffre n'est pas affecté."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এনভেলপটি খুলেছে কিন্তু এতে কোনো এন্ট্রি নেই — পাঠানোর সময় ফিল্ডগুলো খালি রাখা হয়ে থাকতে পারে। আপনার ভল্ট প্রভাবিত হয়নি।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envelope foi aberto, mas não contém itens — os campos podem ter ficado vazios do lado de quem enviou. Seu cofre não foi afetado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конверт открылся, но не содержит записей — возможно, поля были оставлены пустыми на стороне отправителя. Ваше хранилище не затронуто."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لفافہ کھل گیا لیکن اس میں کوئی اندراج نہیں ہے — شاید بھیجنے والے نے فیلڈز خالی چھوڑ دی ہوں۔ آپ کا والٹ متاثر نہیں ہوا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplop terbuka tapi tidak berisi entri — mungkin kolom dibiarkan kosong di sisi pengirim. Brankasmu tidak terpengaruh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umschlag hat sich geöffnet, enthält aber keine Einträge — die Felder wurden auf der Absenderseite möglicherweise leer gelassen. Dein Tresor ist nicht betroffen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "封筒は開きましたが、アイテムが含まれていません — 送信側でフィールドが空のままだった可能性があります。あなたの保管庫は影響を受けていません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The envelope open but e no get any entry inside — maybe dem leave the fields empty from the sender side. Your vault no dey affected."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phong bì đã mở nhưng không chứa mục nào — có thể các trường đã bị bỏ trống ở phía gửi. Kho lưu trữ của bạn không bị ảnh hưởng."
          }
        }
      }
    },
