    "privacy_s5_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo collects data from no one, including children."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo, çocuklar dahil hiç kimseden veri toplamaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo no recopila datos de nadie, incluidos los menores."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo किसी से भी डेटा इकट्ठा नहीं करता, बच्चों से भी नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Sekuvo بيانات من أحد، بمن فيهم الأطفال."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo 不收集任何人（包括儿童）的数据。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo ne collecte de données de personne, y compris des enfants."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo শিশুসহ কারও কাছ থেকেই কোনো তথ্য সংগ্রহ করে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sekuvo não coleta dados de ninguém, incluindo crianças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo не собирает данные ни от кого, включая детей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo کسی سے بھی ڈیٹا جمع نہیں کرتا، بشمول بچوں کے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo tidak mengumpulkan data dari siapa pun, termasuk anak-anak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo sammelt von niemandem Daten, auch nicht von Kindern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvoは子供を含め、誰からもデータを収集しません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo no dey collect data from anybody, including children."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo không thu thập dữ liệu từ bất kỳ ai, kể cả trẻ em."
          }
        }
      }
    },
