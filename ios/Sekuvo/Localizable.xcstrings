    "bt_open_setup_wizard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer not listed or not connecting? Open the setup wizard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarın listede yok ya da bağlanmıyor mu? Kurulum sihirbazını aç"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El ordenador no aparece o no se conecta? Abrir el asistente de configuración"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर सूची में नहीं है या कनेक्ट नहीं हो रहा? सेटअप विज़ार्ड खोलें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحاسوب ليس في القائمة أو لا يتصل؟ افتح معالج الإعداد"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表中没有电脑或无法连接？打开设置向导"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinateur absent de la liste ou pas de connexion ? Ouvrir l'assistant de configuration"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটার তালিকায় নেই বা সংযোগ হচ্ছে না? সেটআপ উইজার্ড খুলুন"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não está na lista ou não conecta? Abra o assistente de configuração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютера нет в списке или он не подключается? Откройте мастер настройки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر فہرست میں نہیں یا منسلک نہیں ہو رہا؟ سیٹ اپ ویزرڈ کھولیں"
          }
