    "home_tag_delete_msg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" will be deleted and removed from the entries that carry it. The entries themselves are not deleted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" silinecek ve taşıyan kayıtlardan kaldırılacak. Kayıtların kendisi silinmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se eliminará y se quitará de las entradas que la llevan. Las entradas en sí no se eliminan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» मिट जाएगा और इसे रखने वाली एंट्री से हट जाएगा। एंट्री खुद नहीं मिटतीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف «%1$@» ويُزال من المدخلات التي تحمله. المدخلات نفسها لا تُحذف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”将被删除，并从带有该标签的条目中移除。条目本身不会被删除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » sera supprimée et retirée des entrées qui la portent. Les entrées elles-mêmes ne sont pas supprimées."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” মুছে যাবে এবং এটি থাকা এন্ট্রিগুলো থেকে সরে যাবে। এন্ট্রিগুলো নিজে মুছে যাবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” será excluída e removida dos itens que a possuem. Os itens em si não são excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» будет удалена и снята со всех записей, где она стоит. Сами записи не удаляются."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» حذف ہو جائے گا اور اسے رکھنے والے تمام اندراجات سے ہٹا دیا جائے گا۔ اندراجات خود حذف نہیں ہوں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” akan dihapus dan dilepas dari semua entri yang memilikinya. Entri itu sendiri tidak dihapus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird gelöscht und von allen Einträgen entfernt, die es tragen. Die Einträge selbst werden nicht gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は削除され、付いているすべてのアイテムから外されます。アイテム自体は削除されません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” go delete and e go comot from every entry wey carry am. The entries demself no go delete."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sẽ bị xóa và gỡ khỏi tất cả các mục có gắn thẻ này. Bản thân các mục sẽ không bị xóa."
          }
        }
      }
    },
