    "privacy_s1_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo does not collect, transmit or share any data. It is an offline password vault and does not request the Internet permission, so it is technically incapable of sending your data anywhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo hiçbir veri toplamaz, iletmez ve paylaşmaz. Çevrimdışı bir parola kasasıdır ve İnternet izni istemez; dolayısıyla verini bir yere göndermesi teknik olarak mümkün değildir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo no recopila, transmite ni comparte ningún dato. Es una bóveda de contraseñas sin conexión y no solicita el permiso de Internet, así que es técnicamente incapaz de enviar tus datos a ninguna parte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo कोई डेटा इकट्ठा, प्रसारित या साझा नहीं करता। यह एक ऑफ़लाइन पासवर्ड तिजोरी है और इंटरनेट अनुमति नहीं माँगता, इसलिए यह तकनीकी रूप से आपका डेटा कहीं भेज ही नहीं सकता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Sekuvo أي بيانات ولا ينقلها ولا يشاركها. إنه خزنة كلمات مرور تعمل بلا اتصال ولا يطلب إذن الإنترنت، فهو عاجز تقنيًّا عن إرسال بياناتك إلى أي مكان."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo 不收集、不传输、也不分享任何数据。它是一款离线密码库，不请求互联网权限，因此在技术上无法将你的数据发送到任何地方。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo ne collecte, ne transmet ni ne partage aucune donnée. C'est un coffre de mots de passe hors ligne qui ne demande pas la permission Internet ; il est donc techniquement incapable d'envoyer tes données où que ce soit."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo কোনো তথ্য সংগ্রহ, প্রেরণ বা শেয়ার করে না। এটি একটি অফলাইন পাসওয়ার্ড ভল্ট এবং ইন্টারনেট অনুমতি চায় না, তাই কারিগরিভাবে এটি আপনার তথ্য কোথাও পাঠাতে পারে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sekuvo não coleta, transmite nem compartilha nenhum dado. É um cofre de senhas offline e não solicita a permissão de Internet, então é tecnicamente incapaz de enviar seus dados para qualquer lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo не собирает, не передаёт и не делится никакими данными. Это офлайн-хранилище паролей, не запрашивающее разрешение на интернет, поэтому технически неспособное отправить ваши данные куда-либо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo کوئی بھی ڈیٹا جمع، منتقل، یا شیئر نہیں کرتا۔ یہ ایک آف لائن پاس ورڈ والٹ ہے، جو انٹرنیٹ کی اجازت نہیں مانگتا، اس لیے تکنیکی طور پر آپ کا ڈیٹا کہیں بھی نہیں بھیج سکتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo tidak mengumpulkan, mengirim, atau membagikan data apa pun. Ini adalah brankas kata sandi offline yang tidak meminta izin internet, sehingga secara teknis tidak bisa mengirim datamu ke mana pun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo sammelt, überträgt oder teilt keinerlei Daten. Es ist ein Offline-Passworttresor, der nicht nach der Internetberechtigung fragt und daher technisch nicht in der Lage ist, deine Daten irgendwohin zu senden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvoはいかなるデータも収集、送信、共有しません。これはインターネット権限を要求しないオフラインのパスワード保管庫であり、技術的にあなたのデータをどこにも送信できません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo no dey collect, transmit, or share any data. E be offline password vault wey no dey ask for Internet permission, so technically e no fit send your data go anywhere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo không thu thập, truyền tải, hay chia sẻ bất kỳ dữ liệu nào. Đây là một kho lưu trữ mật khẩu ngoại tuyến không yêu cầu quyền Internet, nên về mặt kỹ thuật không thể gửi dữ liệu của bạn đi bất cứ đâu."
          }
        }
      }
    },
