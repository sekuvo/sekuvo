    "tour_vault_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is encrypted with a key derived from your master password. Sekuvo has no internet permission: your data goes nowhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey ana parolandan türetilen anahtarla şifrelenir. Sekuvo'nun internet izni yok: verilerin hiçbir yere gitmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se cifra con una clave derivada de tu contraseña maestra. Sekuvo no tiene permiso de Internet: tus datos no van a ninguna parte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ आपके मास्टर पासवर्ड से बनी कुंजी से एन्क्रिप्ट होता है। Sekuvo के पास इंटरनेट अनुमति नहीं है: आपका डेटा कहीं नहीं जाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء مشفَّر بمفتاح مشتقّ من كلمة مرورك الرئيسية. لا يملك Sekuvo إذن الإنترنت: بياناتك لا تذهب إلى أي مكان."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都用由主密码派生的密钥加密。Sekuvo 没有互联网权限：你的数据哪里也不会去。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est chiffré avec une clé dérivée de ton mot de passe principal. Sekuvo n'a pas la permission Internet : tes données ne vont nulle part."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু আপনার মূল পাসওয়ার্ড থেকে তৈরি একটি কী দিয়ে এনক্রিপ্ট করা হয়। Sekuvo-র ইন্টারনেট অনুমতি নেই: আপনার তথ্য কোথাও যায় না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é criptografado com uma chave derivada da sua senha principal. O Sekuvo não tem permissão de internet: seus dados não vão para lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё шифруется ключом, полученным из вашего основного пароля. У Sekuvo нет разрешения на интернет: ваши данные никуда не уходят."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ آپ کے ماسٹر پاس ورڈ سے حاصل کردہ کلید سے مرمز ہوتا ہے۔ Sekuvo کے پاس انٹرنیٹ کی اجازت نہیں: آپ کا ڈیٹا کہیں نہیں جاتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya dienkripsi dengan kunci yang diturunkan dari kata sandi utamamu. Sekuvo tidak punya izin internet: datamu tidak dikirim ke mana pun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird mit einem Schlüssel verschlüsselt, der aus deinem Hauptpasswort abgeleitet ist. Sekuvo hat keine Internetberechtigung: Deine Daten gehen nirgendwohin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータは、マスターパスワードから導出された鍵で暗号化されます。Sekuvoにはインターネット権限がないため、データがどこかへ送られることはありません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything dey encrypt with key wey dem derive from your master password. Sekuvo no get internet permission: your data no dey go anywhere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được mã hóa bằng khóa dẫn xuất từ mật khẩu chính của bạn. Sekuvo không có quyền Internet: dữ liệu của bạn không đi đâu cả."
          }
        }
      }
    },
