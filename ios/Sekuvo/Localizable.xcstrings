    "vm_biometric_stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint record was older than this PIN; it has been deleted. Unlock with your master password and enable the fingerprint again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi kaydı bu PIN'den eskiydi; kayıt silindi. Ana parolanla aç ve parmak izini yeniden etkinleştir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de huella era más antiguo que este PIN; se ha eliminado. Desbloquea con tu contraseña maestra y activa la huella de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट रिकॉर्ड इस PIN से पुराना था; इसे मिटा दिया गया है। मास्टर पासवर्ड से अनलॉक करें और फ़िंगरप्रिंट फिर से चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان سجل البصمة أقدم من هذا الرمز PIN؛ تم حذفه. افتح القفل بكلمة مرورك الرئيسية وفعّل البصمة مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹记录早于此 PIN，已被删除。请用主密码解锁并重新启用指纹。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'empreinte biométrique était plus ancienne que ce PIN ; elle a été supprimée. Déverrouille avec ton mot de passe principal et réactive l'empreinte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিঙ্গারপ্রিন্ট রেকর্ডটি এই PIN-এর চেয়ে পুরনো; এটি মুছে ফেলা হয়েছে। মূল পাসওয়ার্ড দিয়ে আনলক করুন এবং ফিঙ্গারপ্রিন্ট আবার চালু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de impressão digital era mais antigo que este PIN; ele foi excluído. Desbloqueie com sua senha principal e ative a impressão digital de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись отпечатка была старше этого PIN-кода; она удалена. Разблокируйте основным паролем и снова включите отпечаток."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فنگر پرنٹ ریکارڈ اس PIN سے پرانا تھا؛ اسے حذف کر دیا گیا ہے۔ ماسٹر پاس ورڈ سے تالا کھولیں اور فنگر پرنٹ دوبارہ فعال کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data sidik jari lebih lama dari PIN ini; sudah dihapus. Buka kunci dengan kata sandi utamamu dan aktifkan lagi sidik jari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdruck-Eintrag war älter als dieser PIN; er wurde gelöscht. Entsperre mit deinem Hauptpasswort und aktiviere den Fingerabdruck erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋データがこのPINより古いため削除されました。マスターパスワードでロックを解除し、指紋を再度有効にしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint record old pass dis PIN; dem don delete am. Unlock with your master password and turn on fingerprint again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi vân tay cũ hơn mã PIN này; nó đã bị xóa. Hãy mở khóa bằng mật khẩu chính của bạn và bật lại vân tay."
          }
        }
      }
    },
    "vm_copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ copied · clipboard clears in 45 s, or when you return to the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kopyalandı · pano 45 sn içinde, en geç uygulamaya dönünce temizlenir"
