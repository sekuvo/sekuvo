    "vm_vault_locked_retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault has locked — unlock it with your master password and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa kilitlendi — ana parolanla açıp tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bóveda se ha bloqueado — desbloquéala con tu contraseña maestra e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी लॉक हो गई है — मास्टर पासवर्ड से अनलॉक कर फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُفلت الخزنة — افتح قفلها بكلمة مرورك الرئيسية وحاول مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码库已锁定 — 请用主密码解锁后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre s'est verrouillé — déverrouille-le avec ton mot de passe principal et réessaie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট লক হয়ে গেছে — মূল পাসওয়ার্ড দিয়ে আনলক করে আবার চেষ্টা করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre bloqueou — desbloqueie-o com sua senha principal e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище заблокировалось — разблокируйте его основным паролем и попробуйте снова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ مقفل ہو گیا — ماسٹر پاس ورڈ سے تالا کھولیں اور دوبارہ کوشش کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankas terkunci — buka kunci dengan kata sandi utamamu dan coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor hat sich gesperrt — entsperre ihn mit deinem Hauptpasswort und versuche es erneut."
