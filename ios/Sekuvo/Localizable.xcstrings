    "setup_pair_choice_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is already paired with a computer. What would you like to do?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon daha önce bir bilgisayarla eşleşmiş. Ne yapalım?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono ya está emparejado con un ordenador. ¿Qué quieres hacer?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन पहले से किसी कंप्यूटर के साथ पेयर है। आप क्या करना चाहेंगे?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الهاتف مقترن بالفعل بحاسوب. ماذا تريد أن تفعل؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已与一台电脑配对。你想怎么做？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone est déjà appairé à un ordinateur. Que veux-tu faire ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনটি আগে থেকেই একটি কম্পিউটারের সাথে জোড়া লাগানো আছে। আপনি কী করতে চান?"
          }
        },
        "pt-BR": {
