          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayo siapkan ponselnya"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereiten wir das Telefon vor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を準備しましょう"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Make we prepare the phone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chuẩn bị điện thoại"
          }
        }
      }
    },
    "setup_search_chromeos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The corner with the clock → Bluetooth → Pair new device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin olduğu köşe → Bluetooth → Yeni cihaz eşle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La esquina del reloj → Bluetooth → Vincular nuevo dispositivo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे नीचे दाईं ओर समय → ब्लूटूथ → नया डिवाइस जोड़ें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزاوية التي فيها الساعة ← بلوتوث ← إقران جهاز جديد"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕角落的时间 → 蓝牙 → 为新设备配对"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coin avec l'heure → Bluetooth → Associer un nouvel appareil"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কোণে ঘড়ি আছে → ব্লুটুথ → নতুন ডিভাইস পেয়ার করুন"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Horário no canto inferior direito → Bluetooth → Parear novo dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угол экрана с часами → Bluetooth → Подключить новое устройство"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑی والا کونا ← بلوٹوتھ ← نئے آلے کا جوڑا بنائیں"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam di kanan bawah → Bluetooth → Sambungkan perangkat baru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ecke mit der Uhrzeit → Bluetooth → Neues Gerät koppeln"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下の時刻 → Bluetooth → 新しいデバイスとペア設定"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The corner wey get the clock → Bluetooth → Pair new device"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góc màn hình có đồng hồ → Bluetooth → Ghép nối thiết bị mới"
          }
        }
      }
    },
    "setup_search_linux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → Bluetooth (on KDE: System Settings → Bluetooth → Add new device)"
          }
