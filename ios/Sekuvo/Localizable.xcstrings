    "setup_test_different_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout is wrong: pick your computer's layout above, delete the text on the computer and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen yanlış: yukarıdan bilgisayarının düzenini seç, bilgisayardaki yazıyı sil ve tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distribución es incorrecta: elige arriba la de tu ordenador, borra el texto en el ordenador e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेआउट ग़लत है: ऊपर से अपने कंप्यूटर का लेआउट चुनें, कंप्यूटर पर लिखा टेक्स्ट मिटाएँ और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخطيط خاطئ: اختر تخطيط حاسوبك أعلاه، واحذف النص في الحاسوب، ثم حاول مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局不对：请在上方选择你电脑的布局，删除电脑上的文字后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition est incorrecte : choisis celle de ton ordinateur ci-dessus, supprime le texte sur l'ordinateur et réessaie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেআউট ভুল: উপরে আপনার কম্পিউটারের লেআউট বেছে নিন, কম্পিউটারের লেখাটি মুছে আবার চেষ্টা করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O layout está errado: escolha o layout do seu computador acima, apague o texto no computador e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверная раскладка: выберите выше раскладку вашего компьютера, удалите текст на компьютере и попробуйте снова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لے آؤٹ غلط ہے: اوپر سے اپنے کمپیوٹر کا لے آؤٹ منتخب کریں، کمپیوٹر پر لکھا متن حذف کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letaknya salah: pilih tata letak komputermu di atas, hapus teks di komputer, lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Layout ist falsch: Wähle oben das Layout deines Computers, lösche den Text am Computer und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトが違います。上でお使いのコンピューターのレイアウトを選び、コンピューター上の文字を削除してから、もう一度お試しください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout no correct: choose your computer layout up there, delete the text for the computer and try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai bố cục: hãy chọn bố cục của máy tính bạn ở trên, xóa văn bản trên máy tính rồi thử lại."
