    "backup_autofill_locked_save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is locked. Unlock Sekuvo first to save."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa kilitli. Kaydetmek için önce Sekuvo'nun kilidini aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bóveda está bloqueada. Desbloquea Sekuvo primero para guardar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी लॉक है। सहेजने के लिए पहले Sekuvo अनलॉक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة مقفلة. افتح Sekuvo أولًا لتتمكن من الحفظ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码库已锁定。请先解锁 Sekuvo 再保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre est verrouillé. Déverrouille Sekuvo avant d'enregistrer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট লক করা আছে। সংরক্ষণ করতে আগে Sekuvo আনলক করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está bloqueado. Desbloqueie o Sekuvo antes de salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище заблокировано. Сначала разблокируйте Sekuvo, чтобы сохранить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ مقفل ہے۔ محفوظ کرنے کے لیے پہلے Sekuvo کھولیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankas terkunci. Buka Sekuvo dulu untuk menyimpan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor ist gesperrt. Entsperre Sekuvo zuerst, um zu speichern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫がロックされています。保存するには先にSekuvoのロックを解除してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault dey lock. Unlock Sekuvo first before you save."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ đang khóa. Hãy mở khóa Sekuvo trước để lưu."
