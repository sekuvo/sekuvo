        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu karakterler bu düzende yazılamadı: %1$@ — diğer düzeni deneyebilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos caracteres no se pudieron escribir en esta distribución: %1$@ — puedes probar la otra distribución."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अक्षर इस लेआउट में टाइप नहीं हो सके: %1$@ — दूसरा लेआउट आज़मा सकते हैं।"
