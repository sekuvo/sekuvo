    "bt_aborted_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing was cut short: %1$lld / %2$lld characters. The text on the computer is INCOMPLETE — delete it, pick a slower speed and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma yarıda kesildi: %1$lld / %2$lld karakter. Bilgisayardaki metin EKSİK — sil, daha yavaş bir hız seçip tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura se cortó: %1$lld / %2$lld caracteres. El texto en el ordenador está INCOMPLETO — bórralo, elige una velocidad más lenta e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइपिंग बीच में कट गई: %1$lld / %2$lld अक्षर। कंप्यूटर पर टेक्स्ट अधूरा है — उसे मिटाएँ, धीमी गति चुनें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطعت الكتابة: %1$lld / %2$lld محرفًا. النص في الحاسوب غير مكتمل — احذفه، واختر سرعة أبطأ، وحاول مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入被中断：%1$lld / %2$lld 个字符。电脑上的文本不完整 — 请删除、选择更慢的速度后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie a été interrompue : %1$lld / %2$lld caractères. Le texte sur l'ordinateur est INCOMPLET — supprime-le, choisis une vitesse plus lente et réessaie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপিং মাঝপথে থেমে গেছে: %1$lld / %2$lld অক্ষর। কম্পিউটারের লেখাটি অসম্পূর্ণ — মুছে ফেলুন, ধীরগতি বেছে আবার চেষ্টা করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação foi interrompida: %1$lld / %2$lld caracteres. O texto no computador está INCOMPLETO — apague-o, escolha uma velocidade mais lenta e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод был прерван: %1$lld / %2$lld символов. Текст на компьютере НЕПОЛНЫЙ — удалите его, выберите более низкую скорость и попробуйте снова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائپنگ منقطع ہو گئی: %1$lld / %2$lld حروف۔ کمپیوٹر پر موجود متن نامکمل ہے — اسے حذف کریں، کم رفتار منتخب کریں، اور دوبارہ کوشش کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengetikan terputus: %1$lld / %2$lld karakter. Teks di komputer TIDAK LENGKAP — hapus, pilih kecepatan lebih rendah, dan coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabe wurde unterbrochen: %1$lld / %2$lld Zeichen. Der Text am Computer ist UNVOLLSTÄNDIG — lösche ihn, wähle eine niedrigere Geschwindigkeit und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力が中断されました: %1$lld / %2$lld文字。コンピューター上のテキストは不完全です — 削除し、速度を下げてもう一度お試しください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The typing cut: %1$lld / %2$lld character. The text for the computer no complete — delete am, choose slower speed, and try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nhập liệu bị gián đoạn: %1$lld / %2$lld ký tự. Văn bản trên máy tính CHƯA HOÀN CHỈNH — hãy xóa nó, chọn tốc độ chậm hơn, và thử lại."
          }
        }
      }
    },
    "bt_before_start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the cursor in the target field on the computer, then press the button. Typing starts 1 second later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarda imleci yazılacak alana getir, sonra düğmeye bas. 1 saniye sonra yazma başlar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el cursor en el campo de destino del ordenador y luego pulsa el botón. La escritura empieza 1 segundo después."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कर्सर को कंप्यूटर पर लक्ष्य फ़ील्ड में रखें, फिर बटन दबाएँ। टाइपिंग 1 सेकंड बाद शुरू होती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع المؤشر في الحقل الهدف على الحاسوب، ثم اضغط الزر. تبدأ الكتابة بعد ثانية واحدة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将光标放在电脑上的目标字段中，然后按下按钮。1 秒后开始输入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place le curseur dans le champ cible sur l'ordinateur, puis appuie sur le bouton. La saisie commence 1 seconde après."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে লক্ষ্য ফিল্ডে কার্সার রেখে বোতাম চাপুন। ১ সেকেন্ড পর টাইপিং শুরু হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o cursor no campo de destino no computador e depois pressione o botão. A digitação começa 1 segundo depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите курсор в нужное поле на компьютере, затем нажмите кнопку. Ввод начнётся через 1 секунду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر پر ہدف فیلڈ میں کرسر رکھیں، پھر بٹن دبائیں۔ ٹائپنگ 1 سیکنڈ بعد شروع ہوگی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan kursor di kolom tujuan di komputer, lalu tekan tombol. Pengetikan dimulai 1 detik kemudian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den Cursor am Computer in das Zielfeld und drücke dann die Taste. Die Eingabe beginnt 1 Sekunde später."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターの目的のフィールドにカーソルを置いてから、ボタンを押してください。1秒後に入力が始まります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the cursor for the field wey you want am for the computer, then press the button. The typing go start after 1 second."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt con trỏ vào ô đích trên máy tính, rồi nhấn nút. Việc nhập liệu sẽ bắt đầu sau 1 giây."
          }
        }
      }
    },
