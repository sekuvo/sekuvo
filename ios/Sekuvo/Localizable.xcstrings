          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton code PIN Sekuvo est requis pour enregistrer l'empreinte biométrique"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিঙ্গারপ্রিন্ট রেকর্ড সংরক্ষণ করতে আপনার Sekuvo PIN প্রয়োজন"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu PIN do Sekuvo é necessário para salvar o registro de impressão digital"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сохранения записи отпечатка требуется ваш PIN-код Sekuvo"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فنگر پرنٹ ریکارڈ محفوظ کرنے کے لیے آپ کا Sekuvo PIN درکار ہے"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN Sekuvo diperlukan untuk menyimpan data sidik jari"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sekuvo-PIN wird benötigt, um den Fingerabdruck zu speichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋データを保存するにはSekuvoのPINが必要です"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your Sekuvo PIN before we fit save the fingerprint record"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần mã PIN Sekuvo của bạn để lưu bản ghi vân tay"
          }
        }
      }
    },
    "main_biometric_offer_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of typing your master password every time you open the vault, you can use your fingerprint. The master password does not go away: it always works when you need it, and it is also what opens your backups — don't forget it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasayı her açışta ana parolayı yazmak yerine parmak izini kullanabilirsin. Ana parola kaybolmaz: gerektiğinde her zaman çalışır ve yedekleri açan da odur — unutma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de escribir tu contraseña maestra cada vez que abres la bóveda, puedes usar tu huella. La contraseña maestra no desaparece: siempre funciona cuando la necesitas, y es también la que abre tus copias de seguridad — no la olvides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी खोलने पर हर बार मास्टर पासवर्ड टाइप करने के बजाय आप फ़िंगरप्रिंट इस्तेमाल कर सकते हैं। मास्टर पासवर्ड ख़त्म नहीं होता: ज़रूरत पड़ने पर हमेशा काम करता है, और यही आपके बैकअप भी खोलता है — इसे भूलें नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدلًا من كتابة كلمة المرور الرئيسية في كل مرة تفتح فيها الخزنة، يمكنك استخدام بصمتك. كلمة المرور الرئيسية لا تختفي: تعمل دائمًا عند الحاجة إليها، وهي أيضًا ما يفتح نسخك الاحتياطية — لا تنسها."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以用指纹代替每次打开密码库时输入主密码。主密码不会消失：需要时它始终有效，也是打开备份文件所需的密码 — 请不要忘记它。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de saisir ton mot de passe principal à chaque ouverture du coffre, tu peux utiliser ton empreinte. Le mot de passe principal ne disparaît pas : il fonctionne toujours quand tu en as besoin, et c'est aussi lui qui ouvre tes sauvegardes — ne l'oublie pas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবার ভল্ট খোলার সময় মূল পাসওয়ার্ড টাইপ করার বদলে, আপনি ফিঙ্গারপ্রিন্ট ব্যবহার করতে পারেন। মূল পাসওয়ার্ড হারিয়ে যায় না: প্রয়োজনে এটি সবসময় কাজ করে, এবং এটিই আপনার ব্যাকআপ খোলার একমাত্র উপায় — এটি ভুলে যাবেন না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de digitar sua senha principal toda vez que abrir o cofre, você pode usar sua impressão digital. A senha principal não desaparece: sempre funciona quando você precisar dela, e também é ela que abre seus backups — não a esqueça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо ввода основного пароля каждый раз при открытии хранилища вы можете использовать отпечаток пальца. Основной пароль никуда не исчезает: он всегда работает, когда нужен, и именно им открываются ваши резервные копии — не забывайте его."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر بار والٹ کھولتے وقت ماسٹر پاس ورڈ ٹائپ کرنے کے بجائے، آپ اپنا فنگر پرنٹ استعمال کر سکتے ہیں۔ ماسٹر پاس ورڈ کہیں نہیں جاتا: جب بھی ضرورت ہو یہ کام کرتا ہے، اور یہی وہ چیز بھی ہے جو آپ کے بیک اپس کھولتی ہے — اسے مت بھولیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alih-alih mengetik kata sandi utama setiap kali membuka brankas, kamu bisa menggunakan sidik jari. Kata sandi utama tidak hilang: selalu berfungsi saat dibutuhkan, dan itu juga yang membuka cadanganmu — jangan sampai lupa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstatt dein Hauptpasswort jedes Mal beim Öffnen des Tresors einzugeben, kannst du deinen Fingerabdruck nutzen. Das Hauptpasswort verschwindet nicht: Es funktioniert immer, wenn du es brauchst, und es ist auch das, womit du deine Backups öffnest — vergiss es nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫を開くたびにマスターパスワードを入力する代わりに、指紋を使うことができます。マスターパスワードがなくなるわけではありません。必要なときは常に機能し、バックアップを開く際にも使うものです — 忘れないでください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead say you go dey type your master password every time you wan open the vault, you fit use your fingerprint. The master password no go anywhere: e go always work when you need am, and na the same one wey go open your backups — no forget am."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay vì gõ mật khẩu chính mỗi lần mở kho lưu trữ, bạn có thể dùng vân tay của mình. Mật khẩu chính không hề biến mất: nó luôn hoạt động khi bạn cần, và cũng chính nó mở các bản sao lưu của bạn — đừng quên nó."
          }
        }
      }
    },
