    "setup_done_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From now on, open an entry and tap the 💻 next to a field: %1$@ will be at the top of the list."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra bir kaydı aç ve alanın yanındaki 💻 simgesine dokun: %1$@ listenin başında olacak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora, abre una entrada y toca el 💻 junto a un campo: %1$@ estará arriba del todo en la lista."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब से कोई एंट्री खोलें और किसी फ़ील्ड के पास 💻 पर टैप करें: %1$@ सूची में सबसे ऊपर होगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الآن فصاعدًا، افتح مدخلة واضغط 💻 بجوار أي حقل: سيكون %1$@ في أعلى القائمة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后只需打开条目，点击字段旁的 💻：%1$@ 会排在列表最前面。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désormais, ouvre une entrée et touche le 💻 à côté d'un champ : %1$@ sera en haut de la liste."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন থেকে একটি এন্ট্রি খুলে কোনো ফিল্ডের পাশের 💻-এ চাপুন: %1$@ তালিকার একদম উপরে থাকবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De agora em diante, abra um item e toque no 💻 ao lado de um campo: %1$@ vai aparecer no topo da lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь откройте запись и нажмите 💻 рядом с полем: %1$@ будет в самом верху списка."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب سے کوئی اندراج کھولیں اور کسی فیلڈ کے پاس 💻 دبائیں: %1$@ فہرست میں سب سے اوپر ہوگا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai sekarang, buka entri dan ketuk 💻 di samping kolom: %1$@ akan berada paling atas di daftar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ab jetzt einen Eintrag und tippe auf das 💻 neben einem Feld: %1$@ steht dann ganz oben in der Liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後は、アイテムを開いてフィールドの横にある💻をタップしてください。%1$@が一覧の一番上に表示されます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "From now, open any entry and tap the 💻 wey dey near one field: %1$@ go dey on top of the list."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ giờ, hãy mở một mục và chạm vào 💻 cạnh một trường: %1$@ sẽ nằm ở đầu danh sách."
          }
        }
      }
    },
