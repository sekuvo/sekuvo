    "main_biometric_decrypt_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint verified, but the key could not be decrypted. Unlock with your password."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi doğrulandı ama anahtar çözülemedi. Parolayla aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huella verificada, pero la clave no se pudo descifrar. Desbloquea con tu contraseña."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट सत्यापित हुआ, पर कुंजी डिक्रिप्ट नहीं हो सकी। पासवर्ड से अनलॉक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّقت البصمة، لكن تعذّر فكّ تشفير المفتاح. افتح القفل بكلمة المرور."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹验证成功，但密钥无法解密。请用密码解锁。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte vérifiée, mais la clé n'a pas pu être déchiffrée. Déverrouille avec ton mot de passe."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিঙ্গারপ্রিন্ট যাচাই হয়েছে, কিন্তু কী ডিক্রিপ্ট করা যায়নি। পাসওয়ার্ড দিয়ে আনলক করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressão digital verificada, mas não foi possível descriptografar a chave. Desbloqueie com sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпечаток подтверждён, но не удалось расшифровать ключ. Разблокируйте паролем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فنگر پرنٹ کی تصدیق ہو گئی، لیکن کلید کو ڈی کرپٹ نہیں کیا جا سکا۔ پاس ورڈ سے تالا کھولیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidik jari terverifikasi, tapi kunci gagal didekripsi. Buka kunci dengan kata sandi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerabdruck bestätigt, aber der Schlüssel konnte nicht entschlüsselt werden. Entsperre mit dem Passwort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋は確認されましたが、鍵を復号できませんでした。パスワードでロックを解除してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem confirm the fingerprint, but the key no fit decrypt. Unlock with password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vân tay đã được xác nhận, nhưng khóa không thể giải mã. Hãy mở khóa bằng mật khẩu."
          }
        }
      }
    },
