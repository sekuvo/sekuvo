    "unlock_master_reminder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder: type your master password this time instead of your fingerprint. A forgotten master password locks the vault and the backups alike."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma: parmak izi yerine bu sefer ana parolanı yaz. Unutulan ana parola kasayı da yedekleri de kilitler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio: escribe tu contraseña maestra esta vez en lugar de tu huella. Una contraseña maestra olvidada bloquea la bóveda y también las copias de seguridad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याद-दिलाना: इस बार फ़िंगरप्रिंट की जगह अपना मास्टर पासवर्ड टाइप करें। भूला हुआ मास्टर पासवर्ड तिजोरी और बैकअप दोनों को लॉक कर देता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير: اكتب كلمة مرورك الرئيسية هذه المرة بدلًا من بصمتك. كلمة مرور رئيسية منسيّة تقفل الخزنة والنسخ الاحتياطية معًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒：这次请输入主密码，而不是用指纹。忘记主密码会同时锁定密码库和所有备份。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel : saisis ton mot de passe principal cette fois-ci au lieu de ton empreinte. Un mot de passe principal oublié verrouille aussi bien le coffre que les sauvegardes."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার: এবার ফিঙ্গারপ্রিন্টের বদলে আপনার মূল পাসওয়ার্ড টাইপ করুন। ভুলে যাওয়া মূল পাসওয়ার্ড ভল্ট এবং ব্যাকআপ দুটোই লক করে দেয়।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete: digite sua senha principal desta vez em vez da impressão digital. Uma senha principal esquecida bloqueia tanto o cofre quanto os backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание: на этот раз введите основной пароль вместо отпечатка. Забытый основной пароль блокирует и хранилище, и резервные копии."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی: اس بار فنگر پرنٹ کے بجائے اپنا ماسٹر پاس ورڈ ٹائپ کریں۔ بھولا ہوا ماسٹر پاس ورڈ والٹ اور بیک اپس دونوں کو مقفل کر دیتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat: ketik kata sandi utamamu kali ini, bukan sidik jari. Kata sandi utama yang terlupakan mengunci brankas maupun cadangan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung: Gib dieses Mal dein Hauptpasswort statt deines Fingerabdrucks ein. Ein vergessenes Hauptpasswort sperrt sowohl den Tresor als auch die Backups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー: 今回は指紋の代わりにマスターパスワードを入力してください。マスターパスワードを忘れると、保管庫とバックアップの両方がロックされます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder: dis time, type your master password instead of your fingerprint. Master password wey you forget go lock both the vault and the backups."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc nhở: hãy gõ mật khẩu chính của bạn lần này thay vì vân tay. Mật khẩu chính bị quên sẽ khóa cả kho lưu trữ lẫn các bản sao lưu."
          }
        }
      }
    },
