    "entry_too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" is too large: %2$lld KB (limit %3$lld KB). Split the long content, or keep it as a file on your computer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" kaydı çok büyük: %2$lld KB (sınır %3$lld KB). Uzun içeriği bölerek ya da dosya olarak bilgisayarda saklayarak ekle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» es demasiado grande: %2$lld KB (límite %3$lld KB). Divide el contenido largo, o consérvalo como archivo en tu ordenador."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» बहुत बड़ी है: %2$lld KB (सीमा %3$lld KB)। लंबी सामग्री बाँटें, या इसे कंप्यूटर पर फ़ाइल के रूप में रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» كبيرة جدًّا: %2$lld كيلوبايت (الحد %3$lld كيلوبايت). قسِّم المحتوى الطويل، أو احتفظ به كملف على حاسوبك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”太大：%2$lld KB（上限 %3$lld KB）。请拆分较长的内容，或将其保存为电脑上的文件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est trop volumineux : %2$lld Ko (limite %3$lld Ko). Divise le contenu long, ou garde-le sous forme de fichier sur ton ordinateur."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” অনেক বড়: %2$lld KB (সীমা %3$lld KB)। লম্বা লেখাটি ভাগ করুন, অথবা কম্পিউটারে ফাইল হিসেবে রাখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” é muito grande: %2$lld KB (limite de %3$lld KB). Divida o conteúdo longo, ou mantenha-o como um arquivo no seu computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» слишком большое: %2$lld КБ (лимит %3$lld КБ). Разделите длинный текст или сохраните его как файл на компьютере."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» بہت بڑا ہے: %2$lld KB (حد %3$lld KB)۔ لمبے متن کو تقسیم کریں، یا اسے کمپیوٹر پر فائل کے طور پر رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” terlalu besar: %2$lld KB (batas %3$lld KB). Pisahkan teks panjang, atau simpan sebagai file di komputer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist zu groß: %2$lld KB (Grenze %3$lld KB). Teile den langen Inhalt auf, oder bewahre ihn als Datei auf deinem Computer auf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は大きすぎます: %2$lld KB（上限%3$lld KB）。長い内容を分割するか、コンピューター上のファイルとして保存してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” too big: %2$lld KB (limit na %3$lld KB). Split the long content, or save am as file for your computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” quá lớn: %2$lld KB (giới hạn %3$lld KB). Hãy chia nhỏ nội dung dài, hoặc lưu nó dưới dạng tệp trên máy tính của bạn."
          }
        }
      }
    },
