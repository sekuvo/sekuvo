    "bt_err_connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the connection. Is the other device's Bluetooth on?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başlatılamadı. Cihazın Bluetooth'u açık mı?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la conexión. ¿Tiene el otro dispositivo el Bluetooth activado?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन शुरू नहीं हो सका। क्या दूसरे डिवाइस का ब्लूटूथ चालू है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء الاتصال. هل بلوتوث الجهاز الآخر مفعَّل؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法建立连接。对方设备的蓝牙是否已开启？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la connexion. Le Bluetooth de l'autre appareil est-il activé ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ শুরু করা যায়নি। অন্য ডিভাইসের ব্লুটুথ কি চালু আছে?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a conexão. O Bluetooth do outro dispositivo está ligado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать соединение. Включён ли Bluetooth на другом устройстве?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن شروع نہیں ہو سکا۔ کیا دوسرے ڈیوائس کا بلوٹوتھ آن ہے؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa memulai koneksi. Apakah Bluetooth perangkat lain aktif?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung konnte nicht gestartet werden. Ist Bluetooth am anderen Gerät aktiviert?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を開始できませんでした。相手の端末のBluetoothはオンですか？"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection no fit start. Bluetooth for the other device dey on?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu kết nối. Bluetooth trên thiết bị kia có đang bật không?"
          }
        }
      }
    },
    "bt_err_no_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
