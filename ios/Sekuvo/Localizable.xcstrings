            "state": "translated",
            "value": "Peringatan: semua entri yang ada akan dihapus dan digantikan oleh entri dari amplop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Jeder bestehende Eintrag wird gelöscht und durch die des Umschlags ersetzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告: 既存のすべてのアイテムが削除され、封筒の内容に置き換わります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: every entry wey dey there before go delete and the envelope own go replace am."
          }
        },
        "vi": {
