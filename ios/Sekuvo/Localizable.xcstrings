          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ скопировано · буфер очистится через 45 с или при возврате в приложение"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کاپی ہو گیا · کلپ بورڈ 45 سیکنڈ میں یا ایپ پر واپسی پر صاف ہو گا"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ disalin · papan klip dihapus dalam 45 detik atau saat kembali ke aplikasi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kopiert · Zwischenablage wird in 45 s oder bei Rückkehr zur App geleert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をコピーしました · クリップボードは45秒後、またはアプリに戻ったときに消去されます"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ don copy · clipboard go clear after 45 seconds or when you come back to di app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép %1$@ · bộ nhớ tạm sẽ xóa sau 45 giây hoặc khi bạn quay lại ứng dụng"
          }
        }
      }
    },
