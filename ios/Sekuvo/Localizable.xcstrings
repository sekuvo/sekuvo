    "transfer_password_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A generated, single-transfer password — you don't need to memorize it, step 2 uses it automatically. Letters+digits: unaffected by keyboard layout differences."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üretilmiş, tek aktarımlık parola — ezberlemene gerek yok, adım 2'de otomatik kullanılacak. Harf+rakam: klavye düzeni farkından etkilenmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una contraseña generada y de un solo uso — no necesitas memorizarla, el paso 2 la usa automáticamente. Letras y dígitos: no le afectan las diferencias de distribución de teclado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जनरेट किया, एक बार इस्तेमाल होने वाला पासवर्ड — इसे याद रखने की ज़रूरत नहीं, चरण 2 इसे अपने आप इस्तेमाल करता है। अक्षर+अंक: कीबोर्ड लेआउट के अंतर से प्रभावित नहीं होते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة مرور مولَّدة للاستخدام مرة واحدة — لا حاجة لحفظها، الخطوة الثانية تستخدمها تلقائيًا. حروف وأرقام: لا تتأثر باختلاف تخطيطات لوحة المفاتيح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个生成的一次性传输密码 — 你无需记住它，第 2 步会自动使用它。字母加数字：不受键盘布局差异影响。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe généré, à usage unique — tu n'as pas besoin de le mémoriser, l'étape 2 l'utilise automatiquement. Lettres et chiffres : non affectés par les différences de disposition de clavier."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার-ব্যবহারযোগ্য একটি তৈরি করা পাসওয়ার্ড — মনে রাখার দরকার নেই, ধাপ ২ এটি নিজে থেকে ব্যবহার করে। অক্ষর+সংখ্যা: কীবোর্ড লেআউটের পার্থক্যে প্রভাবিত হয় না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma senha gerada, de uso único — você não precisa memorizá-la, a etapa 2 a usa automaticamente. Letras e dígitos: não são afetados por diferenças de layout de teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгенерированный одноразовый пароль — запоминать его не нужно, шаг 2 использует его автоматически. Буквы и цифры: не зависят от различий в раскладке клавиатуры."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار استعمال کے لیے تیار کردہ پاس ورڈ — اسے یاد رکھنے کی ضرورت نہیں، مرحلہ 2 اسے خودکار طور پر استعمال کرتا ہے۔ حروف اور ہندسے: کی بورڈ لے آؤٹ کے فرق سے متاثر نہیں ہوتے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi sekali pakai yang dibuat otomatis — kamu tidak perlu mengingatnya, langkah 2 akan menggunakannya secara otomatis. Huruf dan angka: tidak terpengaruh oleh perbedaan tata letak keyboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein generiertes Einmalpasswort — du musst es dir nicht merken, Schritt 2 verwendet es automatisch. Buchstaben und Zahlen: unabhängig von unterschiedlichen Tastaturlayouts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成された使い捨てパスワードです — 覚える必要はなく、ステップ2で自動的に使用されます。英字と数字: キーボードレイアウトの違いに影響されません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Password wey we generate for one-time use — you no need remember am, step 2 go use am automatic. Letters and numbers: keyboard layout differences no dey affect dem."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu được tạo cho một lần dùng — bạn không cần nhớ nó, bước 2 sẽ tự động dùng nó. Chữ cái và số: không bị ảnh hưởng bởi sự khác biệt về bố cục bàn phím."
          }
        }
      }
    },
