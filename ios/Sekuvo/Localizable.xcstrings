    "detail_fingerprint_verify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer: shasum -a 256 file\n(if you pasted it by hand the trailing newline may be missing: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarda: shasum -a 256 dosya\n(elle yapıştırdıysan son satır sonu düşmüş olabilir: printf '%1$@' \"$(cat dosya)\" | shasum -a 256)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un ordenador: shasum -a 256 archivo\n(si lo pegaste a mano puede faltar el salto de línea final: printf '%1$@' \"$(cat archivo)\" | shasum -a 256)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कंप्यूटर पर: shasum -a 256 file\n(हाथ से चिपकाया हो तो अंतिम नई लाइन छूट सकती है: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على حاسوب: shasum -a 256 file\n(إن لصقتها يدويًا فقد يكون سطر النهاية الأخير مفقودًا: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上：shasum -a 256 文件\n（如果是手动粘贴的，可能缺少末尾换行符：printf '%1$@' \"$(cat 文件)\" | shasum -a 256）"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un ordinateur : shasum -a 256 fichier\n(si tu l'as collée à la main, le saut de ligne final peut manquer : printf '%1$@' \"$(cat fichier)\" | shasum -a 256)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে: shasum -a 256 ফাইল\n(হাতে পেস্ট করলে শেষের নিউলাইনটি বাদ যেতে পারে: printf '%1$@' \"$(cat ফাইল)\" | shasum -a 256)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador: shasum -a 256 arquivo\n(se você colou manualmente, pode faltar a quebra de linha final: printf '%1$@' \"$(cat arquivo)\" | shasum -a 256)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере: shasum -a 256 файл\n(если вы вставили вручную, может отсутствовать завершающий перевод строки: printf '%1$@' \"$(cat файл)\" | shasum -a 256)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر پر: shasum -a 256 file\n(اگر دستی طور پر پیسٹ کیا ہو تو آخری نئی لائن غائب ہو سکتی ہے: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di komputer: shasum -a 256 file\n(jika ditempel manual, baris baru terakhir mungkin hilang: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Computer: shasum -a 256 Datei\n(wenn manuell eingefügt, fehlt eventuell der abschließende Zeilenumbruch: printf '%1$@' \"$(cat Datei)\" | shasum -a 256)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターで: shasum -a 256 ファイル名\n（手動で貼り付けた場合、末尾の改行が欠けていることがあります: printf '%1$@' \"$(cat ファイル名)\" | shasum -a 256）"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "For computer: shasum -a 256 file\n(if you paste am with hand, the last newline fit dey missing: printf '%1$@' \"$(cat file)\" | shasum -a 256)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên máy tính: shasum -a 256 tệp\n(nếu bạn dán thủ công, ký tự xuống dòng cuối cùng có thể bị thiếu: printf '%1$@' \"$(cat tệp)\" | shasum -a 256)"
          }
        }
      }
    },
    "detail_fingerprint_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The digest of a short value can be reversed by brute force — do not share this fingerprint."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa değerlerin özeti kaba kuvvetle geri çözülebilir — bu parmak izini paylaşma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de un valor corto puede revertirse por fuerza bruta — no compartas esta huella."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे मान का डाइजेस्ट ब्रूट फ़ोर्स से उलटा जा सकता है — यह फ़िंगरप्रिंट किसी के साथ साझा न करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن عكس بصمة القيمة القصيرة بالقوة الغاشمة — لا تشارك هذه البصمة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较短值的摘要可能被暴力破解还原 — 请勿分享此指纹。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'empreinte d'une valeur courte peut être inversée par force brute — ne partage pas cette empreinte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট মানের ডাইজেস্ট ব্রুট ফোর্স দিয়ে উল্টে ফেলা যেতে পারে — এই ফিঙ্গারপ্রিন্ট শেয়ার করবেন না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hash de um valor curto pode ser revertido por força bruta — não compartilhe esta impressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хеш короткого значения можно подобрать перебором — не делитесь этим отпечатком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختصر قدر کے ہیش کو بروٹ فورس سے الٹا جا سکتا ہے — یہ فنگر پرنٹ کسی کے ساتھ شیئر نہ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash dari nilai pendek bisa dibalik dengan brute force — jangan bagikan sidik jari ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hash eines kurzen Werts lässt sich durch Ausprobieren umkehren — teile diesen Fingerabdruck nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い値のハッシュは総当たりで復元される可能性があります — このフィンガープリントは共有しないでください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The hash of short value fit reverse if dem brute-force am — no share dis fingerprint."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàm băm của giá trị ngắn có thể bị đảo ngược bằng cách dò thử — đừng chia sẻ vân tay này."
          }
        }
      }
    },
