        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المفكرة على الحاسوب (اكتب «المفكرة» في قائمة ابدأ) وضع المؤشر داخلها."
          }
        },
        "zh-Hans": {
