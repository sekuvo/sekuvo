        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ copiado · el portapapeles se borra en 45 s o al volver a la app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ कॉपी हुआ · क्लिपबोर्ड 45 सेकंड में या ऐप पर लौटने पर साफ़ होगा"
