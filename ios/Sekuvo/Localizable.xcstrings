          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer → Paramètres → Bluetooth et appareils → Ajouter un appareil → Bluetooth (Windows 10 : Paramètres → Périphériques → Ajouter un appareil Bluetooth ou un autre appareil)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টার্ট → সেটিংস → ব্লুটুথ ও ডিভাইস → ডিভাইস যোগ করুন → ব্লুটুথ (Windows 10: সেটিংস → ডিভাইস → ব্লুটুথ বা অন্য ডিভাইস যোগ করুন)"
          }
        },
        "pt-BR": {
          "stringUnit": {
