    "settings_biometric_pin_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint record will be encrypted with the PIN: at unlock you are asked for the fingerprint first, then this PIN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi kaydı PIN ile şifrelenecek: açılışta önce parmak izi, sonra bu PIN sorulur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de huella se cifrará con el PIN: al desbloquear se pide primero la huella y luego este PIN."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट रिकॉर्ड PIN से एन्क्रिप्ट होगा: अनलॉक पर पहले फ़िंगरप्रिंट, फिर यह PIN माँगा जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُشفَّر سجل البصمة بـ PIN: عند فتح القفل تُطلب البصمة أولًا، ثم هذا الرمز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹记录将用此 PIN 加密：解锁时会先要求指纹，再要求此 PIN。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'empreinte biométrique sera chiffrée avec le PIN : au déverrouillage, l'empreinte est demandée en premier, puis ce PIN."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিঙ্গারপ্রিন্ট রেকর্ডটি PIN দিয়ে এনক্রিপ্ট হবে: আনলকের সময় আগে ফিঙ্গারপ্রিন্ট, তারপর এই PIN চাওয়া হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de impressão digital será criptografado com o PIN: ao desbloquear, a impressão digital é solicitada primeiro, depois este PIN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись отпечатка будет зашифрована PIN-кодом: при разблокировке сначала запрашивается отпечаток, затем этот PIN-код."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فنگر پرنٹ ریکارڈ PIN سے مرمز ہو جائے گا: تالا کھولتے وقت پہلے فنگر پرنٹ مانگا جائے گا، پھر یہ PIN۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data sidik jari akan dienkripsi dengan PIN: saat membuka kunci, sidik jari diminta dulu, lalu PIN ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdruck wird mit dem PIN verschlüsselt: Beim Entsperren wird zuerst der Fingerabdruck abgefragt, dann dieser PIN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋データがPINで暗号化されます。ロック解除時には、まず指紋、次にこのPINが求められます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint record go encrypt with the PIN: when you dey unlock, dem go ask for fingerprint first, then dis PIN."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi vân tay sẽ được mã hóa bằng PIN: khi mở khóa, hệ thống sẽ hỏi vân tay trước, sau đó là mã PIN này."
          }
        }
      }
    },
