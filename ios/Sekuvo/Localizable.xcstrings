    "edit_discard_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to leave without saving what you entered. Are you sure?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğin bilgiler kaydedilmeden çıkılacak. Emin misin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a punto de salir sin guardar lo que introdujiste. ¿Seguro?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो लिखा उसे सहेजे बिना बाहर जाने वाले हैं। पक्का?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على وشك الخروج دون حفظ ما أدخلته. هل أنت متأكد؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你即将离开而不保存已输入的内容，确定吗？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es sur le point de quitter sans enregistrer ce que tu as saisi. Es-tu sûr ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা লিখেছেন তা না বাঁচিয়ে বেরিয়ে যাচ্ছেন। নিশ্চিত?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está prestes a sair sem salvar o que digitou. Tem certeza?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы собираетесь выйти, не сохранив введённое. Вы уверены?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنی درج کردہ چیزیں محفوظ کیے بغیر باہر جانے والے ہیں۔ کیا آپ کو یقین ہے؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan keluar tanpa menyimpan apa yang sudah dimasukkan. Yakin?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dabei, ohne Speichern zu beenden. Bist du sicher?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容を保存せずに終了しようとしています。よろしいですか？"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "You wan comot without you save wetin you enter. You sure?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sắp thoát mà không lưu những gì đã nhập. Bạn có chắc không?"
          }
        }
      }
    },
