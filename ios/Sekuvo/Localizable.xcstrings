    "edit_password_qr_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the encrypted envelope holding the new password, then enter the transfer password you set on the computer. Only the password is taken; nothing is added to the vault."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni parolayı taşıyan şifreli zarfı okut, sonra bilgisayarda belirlediğin aktarım parolasını gir. Yalnız parola alınır; kasaya kayıt eklenmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el sobre cifrado con la nueva contraseña y luego introduce la contraseña de transferencia que definiste en el ordenador. Solo se toma la contraseña; no se añade nada al cofre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया पासवर्ड रखने वाले एन्क्रिप्टेड लिफ़ाफ़े को स्कैन करें, फिर कंप्यूटर पर तय किया गया ट्रांसफ़र पासवर्ड डालें। केवल पासवर्ड लिया जाता है; कोश में कुछ नहीं जुड़ता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح المظروف المشفَّر الذي يحمل كلمة المرور الجديدة، ثم أدخل كلمة مرور النقل التي حدّدتها على الحاسوب. تُؤخذ كلمة المرور فقط؛ ولا يُضاف شيء إلى الخزنة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描携带新密码的加密信封,然后输入你在电脑上设置的传输密码。只取用密码;不会向密码库添加任何条目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne l'enveloppe chiffrée contenant le nouveau mot de passe, puis saisis le mot de passe de transfert défini sur l'ordinateur. Seul le mot de passe est repris ; rien n'est ajouté au coffre."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন পাসওয়ার্ড বহনকারী এনক্রিপ্টেড এনভেলপ স্ক্যান করুন, তারপর কম্পিউটারে ঠিক করা ট্রান্সফার পাসওয়ার্ড দিন। কেবল পাসওয়ার্ডটিই নেওয়া হয়; ভল্টে কিছু যোগ হয় না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o envelope criptografado com a nova senha e depois digite a senha de transferência definida no computador. Só a senha é aproveitada; nada é adicionado ao cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте зашифрованный конверт с новым паролем, затем введите пароль переноса, заданный на компьютере. Берётся только пароль; в хранилище ничего не добавляется."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا پاس ورڈ رکھنے والا مرمز لفافہ اسکین کریں، پھر کمپیوٹر پر مقرر کیا گیا منتقلی پاس ورڈ درج کریں۔ صرف پاس ورڈ لیا جاتا ہے؛ والٹ میں کچھ شامل نہیں ہوتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai amplop terenkripsi berisi kata sandi baru, lalu masukkan kata sandi transfer yang kamu tetapkan di komputer. Hanya kata sandinya yang diambil; tidak ada yang ditambahkan ke brankas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den verschlüsselten Umschlag mit dem neuen Passwort und gib dann das am Computer festgelegte Übertragungspasswort ein. Es wird nur das Passwort übernommen; dem Tresor wird nichts hinzugefügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいパスワードを含む暗号化された封筒をスキャンし、コンピューターで設定した転送パスワードを入力してください。取り込まれるのはパスワードだけで、保管庫には何も追加されません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the encrypted envelope wey carry the new password, then enter the transfer password wey you set for the computer. Na only the password dem go take; nothing no dey add to the vault."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét phong bì mã hóa chứa mật khẩu mới, rồi nhập mật khẩu chuyển giao đã đặt trên máy tính. Chỉ mật khẩu được lấy; không có gì được thêm vào kho lưu trữ."
          }
        }
      }
    },
