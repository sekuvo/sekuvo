    "vm_pin_biometric_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong PINs. Fingerprint unlock has been turned off; unlock with your master password."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla yanlış PIN. Parmak izi kapatıldı; ana parolanla aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados PIN incorrectos. El desbloqueo por huella se ha desactivado; desbloquea con tu contraseña maestra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत सारे ग़लत PIN। फ़िंगरप्रिंट अनलॉक बंद कर दिया गया है; मास्टर पासवर्ड से अनलॉक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير جدًّا من رموز PIN الخاطئة. أُوقف فتح القفل بالبصمة؛ افتح القفل بكلمة مرورك الرئيسية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 输错次数过多，指纹解锁已关闭；请用主密码解锁。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de PIN incorrects. Le déverrouillage par empreinte a été désactivé ; déverrouille avec ton mot de passe principal."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক বেশি ভুল PIN। ফিঙ্গারপ্রিন্ট আনলক বন্ধ করা হয়েছে; মূল পাসওয়ার্ড দিয়ে আনলক করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos PINs incorretos. O desbloqueio por impressão digital foi desativado; desbloqueie com sua senha principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных PIN-кодов. Разблокировка по отпечатку выключена; разблокируйте основным паролем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہت زیادہ غلط PINs۔ فنگر پرنٹ سے تالا کھولنا بند کر دیا گیا؛ ماسٹر پاس ورڈ سے تالا کھولیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak PIN salah. Buka kunci sidik jari dinonaktifkan; buka kunci dengan kata sandi utamamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele falsche PINs. Das Entsperren per Fingerabdruck wurde deaktiviert; entsperre mit deinem Hauptpasswort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINの入力ミスが多すぎます。指紋によるロック解除は無効になりました。マスターパスワードでロックを解除してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong PIN. Fingerprint unlock don turn off; unlock with your master password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều lần nhập sai PIN. Mở khóa bằng vân tay đã bị tắt; hãy mở khóa bằng mật khẩu chính của bạn."
          }
        }
      }
    },
