          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung nach der Einrichtung ✓ (zum Abbrechen tippen)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定後に復元 ✓（タップで取り消し）"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore after setup ✓ (tap to cancel)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sau khi thiết lập ✓ (chạm để hủy)"
          }
        }
      }
    },
    "unlock_setup_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a master password. All your data is encrypted with a key derived from this password. If you forget it, your data becomes permanently INACCESSIBLE."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ana parola belirle. Tüm verilerin bu paroladan türetilen anahtarla şifrelenir. Bu parolayı unutursan verilerine ERİŞİLEMEZ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define una contraseña maestra. Todos tus datos se cifran con una clave derivada de ella. Si la olvidas, tus datos quedan INACCESIBLES para siempre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मास्टर पासवर्ड सेट करें। आपका सारा डेटा इससे बनी कुंजी से एन्क्रिप्ट होता है। इसे भूलने पर डेटा हमेशा के लिए दुर्गम हो जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد كلمة مرور رئيسية. تُشفَّر كل بياناتك بمفتاح مشتقّ منها. إن نسيتها، تصبح بياناتك غير قابلة للوصول نهائيًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置一个主密码。你的所有数据都用由此密码派生的密钥加密。如果忘记它，数据将永久无法访问。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis un mot de passe principal. Toutes tes données sont chiffrées avec une clé dérivée de ce mot de passe. Si tu l'oublies, tes données deviennent définitivement INACCESSIBLES."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মূল পাসওয়ার্ড সেট করুন। আপনার সব তথ্য এই পাসওয়ার্ড থেকে তৈরি একটি কী দিয়ে এনক্রিপ্ট করা হয়। ভুলে গেলে, আপনার তথ্য স্থায়ীভাবে অ্যাক্সেস করা যাবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma senha principal. Todos os seus dados são criptografados com uma chave derivada dessa senha. Se você a esquecer, seus dados ficam INACESSÍVEIS permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте основной пароль. Все ваши данные шифруются ключом, полученным из этого пароля. Если вы его забудете, данные станут НАВСЕГДА недоступны."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ماسٹر پاس ورڈ سیٹ کریں۔ آپ کا تمام ڈیٹا اس سے حاصل کردہ کلید سے مرمز ہوتا ہے۔ اگر آپ اسے بھول جائیں، تو ڈیٹا ہمیشہ کے لیے ناقابل رسائی ہو جائے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur kata sandi utama. Semua datamu dienkripsi dengan kunci yang diturunkan darinya. Jika kamu melupakannya, datamu menjadi TIDAK BISA DIAKSES selamanya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Hauptpasswort fest. Alle deine Daten werden mit einem daraus abgeleiteten Schlüssel verschlüsselt. Vergisst du es, werden deine Daten dauerhaft UNZUGÄNGLICH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードを設定してください。すべてのデータはこのパスワードから導出された鍵で暗号化されます。忘れると、データは永久にアクセスできなくなります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Set master password. Dem go encrypt all your data with key wey dem derive from dis password. If you forget am, your data go dey INACCESSIBLE forever."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thiết lập một mật khẩu chính. Toàn bộ dữ liệu của bạn được mã hóa bằng khóa dẫn xuất từ mật khẩu này. Nếu bạn quên nó, dữ liệu sẽ trở nên KHÔNG THỂ TRUY CẬP vĩnh viễn."
          }
        }
      }
    },
    "unlock_slogan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your secure vault."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli kasan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bóveda segura."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सुरक्षित तिजोरी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزنتك الآمنة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的安全密码库。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coffre sécurisé."
          }
        },
        "bn": {
