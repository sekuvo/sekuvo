        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت كتابة هذه المحارف بهذا التخطيط: %1$@ — يمكنك تجربة التخطيط الآخر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此键盘布局无法输入这些字符：%1$@ — 你可以尝试其他布局。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces caractères n'ont pas pu être saisis avec cette disposition : %1$@ — tu peux essayer l'autre disposition."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লেআউটে এই অক্ষরগুলো টাইপ করা যায়নি: %1$@ — অন্য লেআউট চেষ্টা করতে পারেন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes caracteres não puderam ser digitados neste layout: %1$@ — você pode tentar o outro layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти символы не удалось ввести в этой раскладке: %1$@ — попробуйте другую раскладку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ حروف اس لے آؤٹ میں ٹائپ نہیں ہو سکے: %1$@ — دوسرا لے آؤٹ آزمائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakter ini tidak bisa diketik dengan tata letak ini: %1$@ — coba tata letak lain."
          }
