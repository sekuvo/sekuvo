          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуск → Параметры → Bluetooth и устройства → Добавить устройство → Bluetooth (Windows 10: Параметры → Устройства → Добавление Bluetooth или другого устройства)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Start → Settings → Bluetooth & devices → Add device → Bluetooth (Windows 10: Settings → Devices → Add Bluetooth or other device)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai → Pengaturan → Bluetooth & perangkat → Tambahkan perangkat → Bluetooth (Windows 10: Pengaturan → Perangkat → Tambahkan Bluetooth atau perangkat lain)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start → Einstellungen → Bluetooth und Geräte → Gerät hinzufügen → Bluetooth (Windows 10: Einstellungen → Geräte → Bluetooth- oder anderes Gerät hinzufügen)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタート → 設定 → Bluetooth とデバイス → デバイスの追加 → Bluetooth（Windows 10: 設定 → デバイス → Bluetooth またはその他のデバイスを追加する）"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
