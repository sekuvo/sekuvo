          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración → Bluetooth (en KDE: Preferencias del sistema → Bluetooth → Añadir nuevo dispositivo)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग → ब्लूटूथ (KDE में: सिस्टम सेटिंग्स → ब्लूटूथ → नया डिवाइस जोड़ें)"
