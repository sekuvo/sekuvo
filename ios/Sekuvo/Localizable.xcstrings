    "qr_camera_analysis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera analysis: %1$@ · hold the code close enough to fill half the screen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera analizi: %1$@ · kareyi ekranın yarısını kaplayacak kadar yakın tut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de cámara: %1$@ · acerca el código hasta llenar la mitad de la pantalla"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा विश्लेषण: %1$@ · कोड को इतना पास रखें कि आधी स्क्रीन भर जाए"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل الكاميرا: %1$@ · قرِّب الرمز حتى يملأ نصف الشاشة"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机分析：%1$@ · 请将二维码靠近，使其占屏幕的一半以上"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse de la caméra : %1$@ · approche le code jusqu'à remplir la moitié de l'écran"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা বিশ্লেষণ: %1$@ · কোডটি কাছে ধরুন যাতে অন্তত অর্ধেক স্ক্রিন জুড়ে থাকে"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise da câmera: %1$@ · aproxime o código até preencher metade da tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ камеры: %1$@ · поднесите код так, чтобы он занимал не менее половины экрана"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
