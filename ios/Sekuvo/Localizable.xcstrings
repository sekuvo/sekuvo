          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ copié · le presse-papiers s'efface dans 45 s ou au retour dans l'app"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ কপি হয়েছে · ক্লিপবোর্ড ৪৫ সেকেন্ডে বা অ্যাপে ফিরলে মুছে যাবে"
