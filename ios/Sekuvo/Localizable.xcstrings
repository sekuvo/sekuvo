            "value": "İzin verilmedi. Uygulama ayarlarından “Yakındaki cihazlar” iznini aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió el permiso. Activa «Dispositivos cercanos» en los ajustes de la aplicación."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति नहीं दी गई। ऐप सेटिंग्स में «आस-पास मौजूद डिवाइस» अनुमति चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُمنح الإذن. فعّل «الأجهزة المجاورة» من إعدادات التطبيق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获得权限。请在应用设置中开启“附近的设备”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La permission n'a pas été accordée. Active « Appareils à proximité » dans les paramètres de l'application."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দেওয়া হয়নি। অ্যাপ সেটিংসে “আশেপাশের ডিভাইস” চালু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão não foi concedida. Ative “Dispositivos por perto” nas configurações do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение не предоставлено. Включите «Устройства поблизости» в настройках приложения."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت نہیں دی گئی۔ ایپ کی سیٹنگز میں «قریبی آلات» آن کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin tidak diberikan. Aktifkan “Perangkat di sekitar” di pengaturan aplikasi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung wurde nicht erteilt. Aktiviere „Geräte in der Nähe“ in den App-Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が許可されませんでした。アプリの設定で「付近のデバイス」をオンにしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "You no give the permission. Turn on “Nearby devices” for the app settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được cấp quyền. Hãy bật “Thiết bị ở gần” trong phần cài đặt ứng dụng."
          }
        }
      }
    },
    "setup_prep_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
