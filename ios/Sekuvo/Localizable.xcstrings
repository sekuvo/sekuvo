    "tour_keyboard_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sekuvo Keyboard types a value straight into the field, and autofill suggests your entries on login forms. Turn both on in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo Klavyesi değeri doğrudan alana yazar; otomatik doldurma ise giriş formlarında kayıtlarını önerir. İkisini de Ayarlar'dan açarsın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Teclado Sekuvo escribe un valor directamente en el campo, y el autocompletado sugiere tus entradas en los formularios de inicio de sesión. Activa ambos en Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo कीबोर्ड मान को सीधे फ़ील्ड में टाइप करता है, और ऑटोफ़िल साइन-इन फ़ॉर्म पर आपकी एंट्री सुझाता है। दोनों को सेटिंग्स में चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتب لوحة مفاتيح Sekuvo القيمة مباشرة في الحقل، ويقترح الملء التلقائي مدخلاتك في نماذج تسجيل الدخول. فعّل الاثنين من الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo 键盘会把值直接输入到字段中，自动填充则会在登录表单上推荐你的条目。两者都可在设置中开启。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Clavier Sekuvo saisit une valeur directement dans le champ, et la saisie automatique propose tes entrées sur les formulaires de connexion. Active les deux dans les Paramètres."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo কীবোর্ড সরাসরি ফিল্ডে মান টাইপ করে, আর অটোফিল সাইন-ইন ফর্মে আপনার এন্ট্রিগুলো প্রস্তাব করে। সেটিংস থেকে দুটোই চালু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Teclado Sekuvo digita um valor direto no campo, e o preenchimento automático sugere seus itens em formulários de login. Ative os dois nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура Sekuvo вводит значение прямо в поле, а автозаполнение предлагает ваши записи в формах входа. Включите обе функции в настройках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo کی بورڈ قدر کو براہ راست فیلڈ میں ٹائپ کرتا ہے، اور آٹو فل لاگ ان فارمز پر آپ کے اندراجات تجویز کرتا ہے۔ دونوں کو سیٹنگز میں آن کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Sekuvo mengetik nilai langsung ke kolom, dan isi otomatis menyarankan entrimu di formulir masuk. Aktifkan keduanya di Pengaturan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sekuvo-Tastatur gibt einen Wert direkt in das Feld ein, und das automatische Ausfüllen schlägt in Login-Formularen deine Einträge vor. Aktiviere beides in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvoキーボードは値をフィールドに直接入力し、自動入力はログインフォームでアイテムを候補として表示します。どちらも設定でオンにできます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekuvo Keyboard dey type value straight inside the field, and autofill dey suggest your entries for login forms. Turn both on for Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím Sekuvo nhập giá trị thẳng vào trường, còn tự động điền gợi ý các mục của bạn trên biểu mẫu đăng nhập. Hãy bật cả hai trong Cài đặt."
          }
        }
      }
    },
