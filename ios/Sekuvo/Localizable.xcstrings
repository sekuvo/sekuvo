    "setup_search_macos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menu → System Settings → Bluetooth (System Preferences on older versions). Keep the window open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menüsü → Sistem Ayarları → Bluetooth (eski sürümlerde Sistem Tercihleri). Pencereyi açık tut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú Apple → Ajustes del Sistema → Bluetooth (Preferencias del Sistema en versiones anteriores). Mantén la ventana abierta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple मेन्यू → सिस्टम सेटिंग → Bluetooth (पुराने वर्शन में सिस्टम प्राथमिकता)। विंडो खुली रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة Apple ← إعدادات النظام ← Bluetooth (تفضيلات النظام في الإصدارات الأقدم). أبقِ النافذة مفتوحة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果菜单 → 系统设置 → 蓝牙（旧版本中为“系统偏好设置”）。请保持该窗口打开。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Pomme → Réglages Système → Bluetooth (Préférences Système sur les anciennes versions). Garde la fenêtre ouverte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple মেনু → সিস্টেম সেটিংস → ব্লুটুথ (পুরনো সংস্করণে সিস্টেম প্রেফারেন্সেস)। উইন্ডোটি খোলা রাখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Apple → Ajustes do Sistema → Bluetooth (Preferências do Sistema em versões mais antigas). Mantenha a janela aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню Apple → Системные настройки → Bluetooth. Оставьте окно открытым."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menu → System Settings → Bluetooth (پرانے ورژنز میں System Preferences)۔ ونڈو کھلی رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Apple → Pengaturan Sistem → Bluetooth (Preferensi Sistem di versi lama). Biarkan jendelanya tetap terbuka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Menü → Systemeinstellungen → Bluetooth. Lass das Fenster geöffnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップルメニュー → システム設定 → Bluetooth（古いバージョンでは「システム環境設定」）。ウィンドウは開いたままにしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menu → System Settings → Bluetooth (System Preferences for older versions). Leave the window open."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Apple → Cài đặt hệ thống → Bluetooth (trên phiên bản cũ: Tùy chọn hệ thống). Hãy để cửa sổ này mở."
          }
        }
      }
    },
    "setup_search_windows": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start → Settings → Bluetooth & devices → Add device → Bluetooth (Windows 10: Settings → Devices → Add Bluetooth or other device)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlat → Ayarlar → Bluetooth ve cihazlar → Cihaz ekle → Bluetooth (Windows 10: Ayarlar → Cihazlar → Bluetooth veya başka cihaz ekle)"
          }
        },
        "es": {
          "stringUnit": {
