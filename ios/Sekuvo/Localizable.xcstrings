    "tour_backup_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an encrypted .vaultbak backup wherever you like. The file and its password bring everything back, even on a new phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli .vaultbak yedeğini istediğin yere kaydet. Dosya ve parolası, telefon değişse bile her şeyi geri getirir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia cifrada .vaultbak donde quieras. El archivo y su contraseña lo restauran todo, incluso en un teléfono nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्टेड .vaultbak बैकअप जहाँ चाहें सहेजें। फ़ाइल और उसका पासवर्ड नए फ़ोन पर भी सब कुछ लौटा देते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ نسخة احتياطية مشفَّرة بصيغة ⁨.vaultbak⁩ أينما شئت. يعيد الملف مع كلمة مروره كل شيء، حتى على هاتف جديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将加密的 .vaultbak 备份保存到你想要的任何位置。有了文件和它的密码，即使换了新手机也能恢复一切。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une sauvegarde chiffrée .vaultbak où tu veux. Le fichier et son mot de passe restaurent tout, même sur un nouveau téléphone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে খুশি একটি এনক্রিপ্টেড .vaultbak ব্যাকআপ সংরক্ষণ করুন। ফাইল আর এর পাসওয়ার্ড দিয়ে নতুন ফোনেও সব ফিরে আসে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um backup .vaultbak criptografado onde quiser. O arquivo e a senha dele trazem tudo de volta, mesmo em um telefone novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните зашифрованную резервную копию .vaultbak где угодно. Файл и его пароль вернут всё, даже на новом телефоне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرمز ⁨.vaultbak⁩ بیک اپ جہاں چاہیں محفوظ کریں۔ فائل اور اس کا پاس ورڈ نئے فون پر بھی سب کچھ واپس لے آتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan cadangan .vaultbak terenkripsi di mana pun kamu mau. File dan kata sandinya memulihkan semuanya, bahkan di ponsel baru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere ein verschlüsseltes .vaultbak-Backup, wo immer du willst. Die Datei und ihr Passwort stellen alles wieder her, auch auf einem neuen Telefon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された.vaultbakバックアップを好きな場所に保存できます。ファイルとそのパスワードがあれば、新しい端末でもすべてを復元できます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Save encrypted .vaultbak backup anywhere wey you like. The file and the password go bring everything back, even for new phone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu bản sao lưu .vaultbak đã mã hóa ở bất cứ đâu bạn muốn. Tệp và mật khẩu của nó sẽ khôi phục mọi thứ, kể cả trên điện thoại mới."
          }
        }
      }
    },
