          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে একটি টেক্সট এডিটর খুলুন (যেমন টেক্সট এডিটর, Kate) এবং এর ভেতরে কার্সার রাখুন।"
