    "main_biometric_invalidated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint unlock is no longer valid (e.g. a new fingerprint was added). Unlock with your password."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi kilidi geçersizleşmiş (ör. yeni parmak izi eklendi). Parolayla aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desbloqueo por huella ya no es válido (p. ej. se añadió una huella nueva). Desbloquea con tu contraseña."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट अनलॉक अब मान्य नहीं है (जैसे नया फ़िंगरप्रिंट जोड़ा गया)। पासवर्ड से अनलॉक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح القفل بالبصمة لم يعد صالحًا (مثلًا أُضيفت بصمة جديدة). افتح القفل بكلمة المرور."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹解锁已失效（例如添加了新指纹）。请用密码解锁。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage par empreinte n'est plus valide (p. ex. une nouvelle empreinte a été ajoutée). Déverrouille avec ton mot de passe."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিঙ্গারপ্রিন্ট আনলক আর বৈধ নেই (যেমন একটি নতুন ফিঙ্গারপ্রিন্ট যোগ হয়েছে)। পাসওয়ার্ড দিয়ে আনলক করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio por impressão digital não é mais válido (por exemplo, uma nova impressão digital foi adicionada). Desbloqueie com sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировка по отпечатку больше не действительна (например, добавлен новый отпечаток). Разблокируйте паролем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فنگر پرنٹ سے تالا کھولنا اب درست نہیں ہے (مثلاً نیا فنگر پرنٹ شامل کیا گیا)۔ پاس ورڈ سے تالا کھولیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci sidik jari sudah tidak valid (misalnya sidik jari baru ditambahkan). Buka kunci dengan kata sandi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entsperren per Fingerabdruck ist nicht mehr gültig (z. B. wurde ein neuer Fingerabdruck hinzugefügt). Entsperre mit dem Passwort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋によるロック解除は無効になりました（例: 新しい指紋が追加された）。パスワードでロックを解除してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint unlock no dey valid again (maybe dem add new fingerprint). Unlock with password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa bằng vân tay không còn hợp lệ nữa (ví dụ đã thêm vân tay mới). Hãy mở khóa bằng mật khẩu."
          }
        }
      }
    },
    "main_biometric_needs_pin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Sekuvo PIN is required to save the fingerprint record"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi kaydı için PIN gerekli"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere tu PIN de Sekuvo para guardar el registro de huella"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट रिकॉर्ड सहेजने के लिए आपका Sekuvo PIN चाहिए"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز PIN الخاص بـ Sekuvo مطلوب لحفظ سجل البصمة"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
