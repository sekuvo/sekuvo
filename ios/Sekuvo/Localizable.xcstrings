    "privacy_s2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles, usernames, passwords, notes and usage history stay on this device, encrypted with a key derived from your master password. Nothing is uploaded, synced or backed up to any server by the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar, kullanıcı adları, parolalar, notlar ve kullanım geçmişi bu cihazda kalır ve ana parolandan türetilen bir anahtarla şifrelenir. Uygulama hiçbir şeyi bir sunucuya yüklemez, eşitlemez, yedeklemez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, usuarios, contraseñas, notas e historial de uso permanecen en este dispositivo, cifrados con una clave derivada de tu contraseña maestra. La aplicación no sube, sincroniza ni respalda nada a ningún servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक, उपयोगकर्ता नाम, पासवर्ड, नोट और उपयोग इतिहास इसी डिवाइस पर, आपके मास्टर पासवर्ड से बनी कुंजी से एन्क्रिप्टेड रहते हैं। ऐप इनमें से कुछ भी किसी सर्वर पर अपलोड, सिंक या बैकअप नहीं करता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى العناوين وأسماء المستخدمين وكلمات المرور والملاحظات وسجل الاستخدام على هذا الجهاز، مشفَّرة بمفتاح مشتقّ من كلمة مرورك الرئيسية. لا يرفع التطبيق شيئًا من هذا إلى أي خادم، ولا يزامنه، ولا ينسخه احتياطيًّا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题、用户名、密码、笔记和使用记录都留在此设备上，并用由主密码派生的密钥加密。应用不会将任何内容上传、同步或备份到任何服务器。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres, identifiants, mots de passe, notes et l'historique d'utilisation restent sur cet appareil, chiffrés avec une clé dérivée de ton mot de passe principal. Rien n'est téléversé, synchronisé ni sauvegardé sur un serveur par l'application."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনাম, ইউজারনেম, পাসওয়ার্ড, নোট এবং ব্যবহারের ইতিহাস এই ডিভাইসেই থাকে, আপনার মূল পাসওয়ার্ড থেকে তৈরি একটি কী দিয়ে এনক্রিপ্ট করা। অ্যাপটি কোনো তথ্য কোনো সার্ভারে আপলোড, সিঙ্ক বা ব্যাকআপ করে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, usuários, senhas, notas e histórico de uso ficam neste dispositivo, criptografados com uma chave derivada da sua senha principal. Nada é enviado, sincronizado ou salvo em backup em nenhum servidor pelo aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия, имена пользователей, пароли, заметки и история использования остаются на этом устройстве, зашифрованные ключом, полученным из вашего основного пароля. Приложение ничего не загружает, не синхронизирует и не резервирует ни на один сервер."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوانات، صارف ناموں، پاس ورڈز، نوٹس، اور استعمال کے لاگ سمیت آپ جو کچھ Sekuvo میں محفوظ کرتے ہیں وہ آپ کی ڈیوائس پر رہتا ہے، آپ کے ماسٹر پاس ورڈ سے حاصل کردہ کلید سے مرمز۔ ایپ اس میں سے کچھ بھی کسی سرور پر اپ لوڈ، سنک، یا بیک اپ نہیں کرتی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul, nama pengguna, kata sandi, catatan, dan riwayat penggunaan tetap ada di perangkat ini, dienkripsi dengan kunci yang diturunkan dari kata sandi utamamu. Aplikasi tidak mengunggah, menyinkronkan, atau mencadangkan apa pun ke server mana pun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Benutzernamen, Passwörter, Notizen und der Nutzungsverlauf bleiben auf diesem Gerät, verschlüsselt mit einem aus deinem Hauptpasswort abgeleiteten Schlüssel. Nichts davon wird von der App auf einen Server hochgeladen, synchronisiert oder gesichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、ユーザー名、パスワード、メモ、使用履歴は、マスターパスワードから導出された鍵で暗号化され、この端末上に保存されます。アプリがこれらをサーバーにアップロード、同期、バックアップすることはありません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles, usernames, passwords, notes, and usage history dey stay for dis device, encrypted with key wey dem derive from your master password. Nothing no dey upload, sync, or backup go any server by the app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề, tên đăng nhập, mật khẩu, ghi chú, và lịch sử sử dụng vẫn ở trên thiết bị này, được mã hóa bằng khóa dẫn xuất từ mật khẩu chính của bạn. Không có gì trong số này được ứng dụng tải lên, đồng bộ hóa, hoặc sao lưu lên bất kỳ máy chủ nào."
          }
        }
      }
    },
    "privacy_s2_title": {
