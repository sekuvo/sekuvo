    "paste_err_password_required_qr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup password required: the password you entered when encrypting the envelope on your computer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek parolası gerekli: zarfı bilgisayarda şifrelerken girdiğin parola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere la contraseña de copia: la que introdujiste al cifrar el sobre en tu ordenador."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप पासवर्ड ज़रूरी है: वही जो कंप्यूटर पर लिफ़ाफ़ा एन्क्रिप्ट करते समय डाला था।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة مرور النسخة مطلوبة: هي التي أدخلتها عند تشفير المظروف على حاسوبك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要备份密码：即你在电脑上加密信封时设置的密码。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe de sauvegarde requis : celui que tu as saisi lors du chiffrement de l'enveloppe sur ton ordinateur."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ পাসওয়ার্ড প্রয়োজন: কম্পিউটারে এনভেলপ এনক্রিপ্ট করার সময় আপনি যেটা দিয়েছিলেন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária a senha de backup: a que você digitou ao criptografar o envelope no seu computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется пароль резервной копии: тот, что вы вводили при шифровании конверта на компьютере."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ پاس ورڈ درکار ہے: وہی جو آپ نے کمپیوٹر پر لفافہ مرمز کرتے وقت درج کیا تھا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi cadangan diperlukan: kata sandi yang kamu masukkan saat mengenkripsi amplop di komputer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup-Passwort wird benötigt: dasjenige, das du beim Verschlüsseln des Umschlags an deinem Computer eingegeben hast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップパスワードが必要です: コンピューターで封筒を暗号化したときに入力したものです。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We need the backup password: the one wey you enter when you encrypt the envelope for your computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có mật khẩu sao lưu: mật khẩu bạn đã nhập khi mã hóa phong bì trên máy tính của bạn."
          }
        }
      }
    },
    "paste_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the text from the page or tap \"Get from clipboard\". The text is encrypted; you will enter its password in the next field."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfadaki metni yapıştır ya da \"Panodan al\"a bas. Metin şifrelidir; parolasını bir sonraki alana gireceksin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el texto de la página o toca «Obtener del portapapeles». El texto está cifrado; introducirás su contraseña en el siguiente campo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज से टेक्स्ट चिपकाएँ या «क्लिपबोर्ड से लें» दबाएँ। यह टेक्स्ट एन्क्रिप्टेड है; इसका पासवर्ड अगले फ़ील्ड में डालेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق النص من الصفحة أو اضغط «الحصول من الحافظة». هذا النص مشفَّر؛ ستُدخل كلمة مروره في الحقل التالي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴页面上的文本，或点击“从剪贴板获取”。文本已加密；你将在下一字段输入其密码。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle le texte de la page ou touche « Obtenir depuis le presse-papiers ». Le texte est chiffré ; tu saisiras son mot de passe dans le champ suivant."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেজ থেকে লেখা পেস্ট করুন অথবা “ক্লিপবোর্ড থেকে নিন” চাপুন। লেখাটি এনক্রিপ্টেড; পরের ফিল্ডে আপনি এর পাসওয়ার্ড দেবেন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o texto da página ou toque em “Obter da área de transferência”. O texto está criptografado; você digitará a senha dele no próximo campo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст со страницы или нажмите «Получить из буфера обмена». Текст зашифрован; его пароль вы введёте в следующем поле."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحے سے متن پیسٹ کریں یا «کلپ بورڈ سے حاصل کریں» دبائیں۔ یہ متن مرمز شدہ ہے؛ اس کا پاس ورڈ آپ اگلے فیلڈ میں درج کریں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel teks dari halaman atau ketuk “Ambil dari papan klip”. Teks ini terenkripsi; kamu akan memasukkan kata sandinya di kolom berikutnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Text von der Seite ein oder tippe auf „Aus Zwischenablage übernehmen“. Dieser Text ist verschlüsselt; sein Passwort gibst du im nächsten Feld ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページのテキストを貼り付けるか、「クリップボードから取得」をタップしてください。このテキストは暗号化されており、そのパスワードは次のフィールドで入力します。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the text from the page or tap “Get from clipboard”. Dis text dey encrypted; you go enter the password for the next field."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán văn bản từ trang, hoặc chạm vào “Lấy từ bộ nhớ tạm”. Văn bản này đã được mã hóa; bạn sẽ nhập mật khẩu của nó vào trường tiếp theo."
          }
        }
      }
    },
