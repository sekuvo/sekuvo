    "tour_bt_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone connects to the computer as a Bluetooth keyboard and types the password key by key where the cursor is. Nothing is installed on the computer. Let's set it up together, live."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon bilgisayara Bluetooth klavye olarak bağlanır ve şifreyi imlecin olduğu yere tuş tuş yazar. Bilgisayara hiçbir şey kurulmaz. Hadi birlikte, canlı olarak kuralım."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono se conecta al ordenador como un teclado Bluetooth y escribe la contraseña tecla a tecla donde esté el cursor. No se instala nada en el ordenador. Configurémoslo juntos, en directo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन ब्लूटूथ कीबोर्ड के रूप में कंप्यूटर से जुड़ता है और कर्सर जहाँ है वहाँ पासवर्ड को एक-एक कुंजी करके टाइप करता है। कंप्यूटर पर कुछ भी इंस्टॉल नहीं होता। आइए, इसे साथ मिलकर अभी, कदम-दर-कदम सेट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل الهاتف بالحاسوب كلوحة مفاتيح بلوتوث ويكتب كلمة المرور مفتاحًا مفتاحًا حيث يوجد المؤشر. لا يُثبَّت أي شيء على الحاسوب. هيا نُعِدّه معًا، مباشرةً."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机会作为蓝牙键盘连接到电脑，在光标所在位置逐键输入密码。电脑上无需安装任何东西。让我们一起实时完成设置。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone se connecte à l'ordinateur comme un clavier Bluetooth et saisit le mot de passe touche par touche là où se trouve le curseur. Rien n'est installé sur l'ordinateur. Configurons-le ensemble, en direct."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটি ব্লুটুথ কীবোর্ড হিসেবে কম্পিউটারের সাথে সংযুক্ত হয় এবং কার্সার যেখানে আছে সেখানে একটার পর একটা কী চেপে পাসওয়ার্ড টাইপ করে। কম্পিউটারে কিছুই ইনস্টল করতে হয় না। চলুন, একসাথে সরাসরি সেট আপ করি।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone se conecta ao computador como um teclado Bluetooth e digita a senha tecla por tecla onde o cursor estiver. Nada é instalado no computador. Vamos configurar juntos, ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон подключается к компьютеру как клавиатура Bluetooth и вводит пароль клавиша за клавишей туда, где стоит курсор. На компьютер ничего не устанавливается. Давайте настроим всё вместе, в реальном времени."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون بلوٹوتھ کی بورڈ کے طور پر کمپیوٹر سے جڑتا ہے اور جہاں کرسر ہو وہاں پاس ورڈ حرف بہ حرف ٹائپ کرتا ہے۔ کمپیوٹر پر کچھ بھی انسٹال نہیں ہوتا۔ آئیے مل کر، براہِ راست، اسے سیٹ اپ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel terhubung ke komputer sebagai keyboard Bluetooth dan mengetik kata sandi tombol demi tombol di posisi kursor. Tidak ada yang perlu diinstal di komputer. Ayo kita siapkan bersama, langsung sekarang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon verbindet sich als Bluetooth-Tastatur mit dem Computer und gibt das Passwort Taste für Taste dort ein, wo der Cursor steht. Auf dem Computer wird nichts installiert. Richten wir es gemeinsam live ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末はBluetoothキーボードとしてコンピューターに接続し、カーソルのある場所にパスワードを1文字ずつ入力します。コンピューターには何もインストールしません。さあ、一緒にその場で設定しましょう。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone go connect to the computer as Bluetooth keyboard and type the password key by key where the cursor dey. Nothing go install for the computer. Make we set am up together, live."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại kết nối với máy tính như một bàn phím Bluetooth và nhập mật khẩu từng phím một tại vị trí con trỏ. Không cần cài gì lên máy tính. Hãy cùng thiết lập ngay, trực tiếp từng bước."
          }
        }
      }
    },
