    "anchor_qr_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the encrypted envelope holding the new anchor, then enter the transfer password you set on the computer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni çıpayı taşıyan şifreli zarfı okut, sonra bilgisayarda belirlediğin aktarım parolasını gir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el sobre cifrado que contiene la nueva ancla y luego introduce la contraseña de transferencia que definiste en el ordenador."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया एंकर रखने वाले एन्क्रिप्टेड लिफ़ाफ़े को स्कैन करें, फिर कंप्यूटर पर तय किया गया ट्रांसफ़र पासवर्ड डालें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح المظروف المشفَّر الذي يحمل المرساة الجديدة، ثم أدخل كلمة مرور النقل التي حدّدتها على الحاسوب."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描携带新锚点的加密信封,然后输入你在电脑上设置的传输密码。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne l'enveloppe chiffrée contenant la nouvelle ancre, puis saisis le mot de passe de transfert défini sur l'ordinateur."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন অ্যাঙ্কর বহনকারী এনক্রিপ্টেড এনভেলপ স্ক্যান করুন, তারপর কম্পিউটারে ঠিক করা ট্রান্সফার পাসওয়ার্ড দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o envelope criptografado com a nova âncora e depois digite a senha de transferência que você definiu no computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте зашифрованный конверт с новым якорем, затем введите пароль переноса, заданный на компьютере."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا اینکر رکھنے والا مرمز لفافہ اسکین کریں، پھر کمپیوٹر پر مقرر کیا گیا منتقلی پاس ورڈ درج کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai amplop terenkripsi berisi jangkar baru, lalu masukkan kata sandi transfer yang kamu tetapkan di komputer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den verschlüsselten Umschlag mit dem neuen Anker und gib dann das am Computer festgelegte Übertragungspasswort ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいアンカーを含む暗号化された封筒をスキャンし、コンピューターで設定した転送パスワードを入力してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the encrypted envelope wey carry the new anchor, then enter the transfer password wey you set for the computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét phong bì mã hóa chứa neo mới, rồi nhập mật khẩu chuyển giao mà bạn đã đặt trên máy tính."
          }
        }
      }
    },
