    "transfer_replace_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: every existing entry is deleted and the ones in the envelope are written instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat: mevcut tüm kayıtlar silinip zarftakiler yazılır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: se elimina cada entrada existente y se escriben en su lugar las del sobre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी: हर मौजूदा एंट्री मिटा दी जाएगी और लिफ़ाफ़े वाली एंट्री उनकी जगह लिखी जाएँगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: ستُحذف كل مدخلة موجودة وتُكتب مكانها مدخلات المظروف."
          }
        },
        "zh-Hans": {
