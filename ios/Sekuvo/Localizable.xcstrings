    "vm_pasted_is_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a link, not the envelope itself. Open the link in the phone's browser and copy the TEXT it shows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir bağlantı, zarfın kendisi değil. Bağlantıyı telefonun tarayıcısında aç ve açılan METNİ kopyala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es un enlace, no el sobre en sí. Abre el enlace en el navegador del teléfono y copia el TEXTO que muestra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक लिंक है, ख़ुद लिफ़ाफ़ा नहीं। फ़ोन के ब्राउज़र में लिंक खोलें और उसमें दिख रहा **टेक्स्ट** कॉपी करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا رابط، لا المظروف نفسه. افتح الرابط في متصفح الهاتف وانسخ **النص** الذي يعرضه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个链接，不是信封本身。请在手机浏览器中打开该链接，并复制其显示的文本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un lien, pas l'enveloppe elle-même. Ouvre le lien dans le navigateur du téléphone et copie le TEXTE affiché."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি লিঙ্ক, এনভেলপ নিজে নয়। ফোনের ব্রাউজারে লিঙ্কটি খুলুন এবং এতে দেখানো লেখাটি কপি করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é um link, não o envelope em si. Abra o link no navegador do telefone e copie o TEXTO exibido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ссылка, а не сам конверт. Откройте ссылку в браузере телефона и скопируйте ТЕКСТ, который она показывает."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایک لنک ہے، لفافہ نہیں۔ فون کے براؤزر میں لنک کھولیں اور دکھایا گیا **متن** کاپی کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tautan, bukan amplopnya sendiri. Buka tautan di browser ponsel dan salin **teks** yang ditampilkannya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Link, nicht der Umschlag selbst. Öffne den Link im Browser des Telefons und kopiere den angezeigten TEXT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはリンクであり、封筒そのものではありません。端末のブラウザでリンクを開き、表示された**テキスト**をコピーしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis one na link, e no be the envelope itself. Open the link for the phone browser and copy the **text** wey e show."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là một liên kết, không phải bản thân phong bì. Hãy mở liên kết trong trình duyệt điện thoại và sao chép **văn bản** mà nó hiển thị."
          }
        }
      }
