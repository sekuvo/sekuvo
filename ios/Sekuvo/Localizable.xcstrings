    "bt_test_expected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer must show EXACTLY this:\n%1$@\nIf it differs, pick the other layout above and repeat the test."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarda TAM OLARAK şu çıkmış olmalı:\n%1$@\nFarklıysa üstteki diğer düzeni seç ve testi tekrarla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador debe mostrar EXACTAMENTE esto:\n%1$@\nSi difiere, elige la otra distribución arriba y repite la prueba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर पर बिल्कुल यही दिखना चाहिए:\n%1$@\nअगर अलग हो, तो ऊपर दूसरा लेआउट चुनें और परीक्षण दोहराएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يظهر في الحاسوب هذا بالضبط:\n%1$@\nإن اختلف، اختر التخطيط الآخر أعلاه وكرّر الاختبار."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上必须显示得和这里完全一致：\n%1$@\n如果不同，请在上方选择另一种布局并重复测试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur doit afficher EXACTEMENT ceci :\n%1$@\nSi c'est différent, choisis l'autre disposition ci-dessus et répète le test."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে ঠিক এটাই দেখাতে হবে:\n%1$@\nযদি ভিন্ন হয়, উপরে অন্য লেআউট বেছে নিয়ে টেস্টটি আবার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador deve mostrar EXATAMENTE isto:\n%1$@\nSe for diferente, escolha o outro layout acima e repita o teste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере должно появиться РОВНО это:\n%1$@\nЕсли отличается, выберите другую раскладку выше и повторите тест."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر پر بالکل یہ ظاہر ہونا چاہیے:\n%1$@\nاگر مختلف ہے، اوپر دوسرا لے آؤٹ منتخب کریں اور ٹیسٹ دہرائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer harus menampilkan PERSIS ini:\n%1$@\nJika berbeda, pilih tata letak lain di atas dan ulangi tes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Computer sollte GENAU dies erscheinen:\n%1$@\nWenn es abweicht, wähle oben das andere Layout und wiederhole den Test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターに次と全く同じ内容が表示されるはずです:\n%1$@\n異なる場合は、上で別のレイアウトを選び、テストを繰り返してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer must show EXACTLY dis:\n%1$@\nIf e different, choose the other layout up there and repeat the test."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính phải hiển thị CHÍNH XÁC nội dung này:\n%1$@\nNếu khác, hãy chọn bố cục khác ở trên và lặp lại thử nghiệm."
          }
        }
      }
    },
