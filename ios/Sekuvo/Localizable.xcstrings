    "privacy_s6_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions: contact@sekuvo.com\nThe authoritative version of this policy is published at sekuvo.com/privacy/ and is the one that governs in case of any difference."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorular için: contact@sekuvo.com\nBu politikanın bağlayıcı sürümü sekuvo.com/privacy/ adresinde yayınlanır; bir farklılık hâlinde geçerli olan odur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas: contact@sekuvo.com\nLa versión oficial de esta política se publica en sekuvo.com/privacy/ y es la que prevalece en caso de cualquier diferencia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सवाल: contact@sekuvo.com\nइस नीति का आधिकारिक वर्शन sekuvo.com/privacy/ पर प्रकाशित है और किसी भी अंतर की स्थिति में वही मान्य होगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسئلة: contact@sekuvo.com\nالنسخة الرسمية من هذه السياسة منشورة على sekuvo.com/privacy/ وهي المرجع عند أي اختلاف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题咨询：contact@sekuvo.com\n本政策的权威版本发布于 sekuvo.com/privacy/，如有差异以该版本为准。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions : contact@sekuvo.com\nLa version faisant foi de cette politique est publiée sur sekuvo.com/privacy/ et prévaut en cas de différence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশ্ন: contact@sekuvo.com\nএই নীতির প্রামাণ্য সংস্করণটি sekuvo.com/privacy/-এ প্রকাশিত এবং কোনো পার্থক্য হলে এটিই কার্যকর থাকবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvidas: contact@sekuvo.com\nA versão oficial desta política é publicada em sekuvo.com/privacy/ e é a que prevalece em caso de qualquer diferença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы: contact@sekuvo.com\nОфициальная версия этой политики опубликована на sekuvo.com/privacy/ и имеет приоритет в случае каких-либо расхождений."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوالات: contact@sekuvo.com\nاس پالیسی کا سرکاری ورژن sekuvo.com/privacy/ پر شائع ہوتا ہے اور کسی بھی اختلاف کی صورت میں یہی معتبر ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan: contact@sekuvo.com\nVersi resmi kebijakan ini dipublikasikan di sekuvo.com/privacy/ dan berlaku jika ada perbedaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen: contact@sekuvo.com\nDie maßgebliche Fassung dieser Erklärung ist unter sekuvo.com/privacy/ veröffentlicht und gilt bei Abweichungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご質問: contact@sekuvo.com\nこのポリシーの正式版はsekuvo.com/privacy/で公開されており、相違がある場合はそちらが優先されます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions: contact@sekuvo.com\nThe official version of dis policy dey published for sekuvo.com/privacy/ and e go be the correct one if difference dey."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi: contact@sekuvo.com\nPhiên bản chính thức của chính sách này được công bố tại sekuvo.com/privacy/ và có giá trị ưu tiên khi có sự khác biệt."
          }
        }
      }
    },
