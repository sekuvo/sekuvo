            "state": "translated",
            "value": "Komputer tidak ada di daftar atau tidak terhubung? Buka wizard penyiapan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer nicht in der Liste oder keine Verbindung? Einrichtungsassistenten öffnen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターが一覧にない、または接続できませんか？ セットアップウィザードを開く"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer no dey the list or e no dey connect? Open the setup wizard"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính không có trong danh sách hoặc không kết nối được? Mở trình hướng dẫn thiết lập"
          }
        }
      }
    },
    "bt_permission_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth permission is required. This feature cannot work without it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth izni gerekli. İzin vermeden bu özellik çalışamaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere el permiso de Bluetooth. Esta función no puede funcionar sin él."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लूटूथ अनुमति ज़रूरी है। इसके बिना यह सुविधा काम नहीं कर सकती।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن البلوتوث مطلوب. لا يمكن لهذه الخاصية العمل بدونه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要蓝牙权限。没有它此功能无法使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La permission Bluetooth est requise. Cette fonction ne peut pas fonctionner sans elle."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্লুটুথ অনুমতি প্রয়োজন। এটি ছাড়া এই ফিচার কাজ করবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de Bluetooth é necessária. Este recurso não funciona sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на Bluetooth. Без него эта функция не работает."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلوٹوتھ کی اجازت درکار ہے۔ اس کے بغیر یہ فیچر کام نہیں کرے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin Bluetooth diperlukan. Fitur ini tidak bisa berfungsi tanpanya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bluetooth-Berechtigung ist erforderlich. Diese Funktion kann ohne sie nicht arbeiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothの権限が必要です。この機能はそれなしでは動作しません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We need Bluetooth permission. Dis feature no go work without am."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có quyền Bluetooth. Tính năng này không thể hoạt động nếu thiếu quyền đó."
          }
        }
      }
    },
    "bt_pick_computer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your computer (it must already be paired with the phone over Bluetooth):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarını seç (önce telefonla Bluetooth'tan eşleştirilmiş olmalı):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu ordenador (debe estar ya emparejado con el teléfono por Bluetooth):"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कंप्यूटर चुनें (वह फ़ोन के साथ पहले से ब्लूटूथ पेयर होना चाहिए):"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حاسوبك (يجب أن يكون مقترنًا بالفعل بالهاتف عبر البلوتوث):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你的电脑（必须已通过蓝牙与手机配对）："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ton ordinateur (il doit déjà être appairé au téléphone par Bluetooth) :"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কম্পিউটার বেছে নিন (এটি আগে থেকেই ফোনের সাথে ব্লুটুথে জোড়া থাকতে হবে):"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha seu computador (ele já deve estar pareado com o telefone via Bluetooth):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите свой компьютер (он должен быть уже сопряжён с телефоном по Bluetooth):"
          }
        },
        "ur": {
