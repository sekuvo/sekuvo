    "vm_backup_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup opened but holds no entries. Your vault is untouched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek açıldı ama içinde kayıt yok. Kasan olduğu gibi duruyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia se abrió pero no contiene entradas. Tu bóveda no se ha visto afectada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप खुला पर उसमें कोई एंट्री नहीं है। आपकी तिजोरी अप्रभावित है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُتحت النسخة الاحتياطية لكنها لا تحتوي على مدخلات. خزنتك سليمة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已打开但不含任何条目。你的密码库未受影响。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde s'est ouverte mais ne contient aucune entrée. Ton coffre n'est pas affecté."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপটি খুলেছে কিন্তু এতে কোনো এন্ট্রি নেই। আপনার ভল্ট প্রভাবিত হয়নি।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup foi aberto, mas não contém itens. Seu cofre não foi afetado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия открылась, но не содержит записей. Ваше хранилище не затронуто."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
