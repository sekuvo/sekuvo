    "paste_qr_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR scanned · encrypted envelope of %1$lld characters received.\nNow enter just the **backup password**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR okundu · %1$lld karakterlik şifreli zarf alındı.\nŞimdi yalnız **yedek parolasını** gir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR escaneado · sobre cifrado de %1$lld caracteres recibido.\nAhora introduce solo la **contraseña de copia**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR स्कैन हुआ · %1$lld अक्षर का एन्क्रिप्टेड लिफ़ाफ़ा मिला।\nअब केवल **बैकअप पासवर्ड** डालें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ تم مسح QR · استُلم مظروف مشفَّر من %1$lld محرفًا.\nأدخل الآن **كلمة مرور النسخة** فقط."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 已扫描二维码 · 已收到 %1$lld 个字符的加密信封。\n现在只需输入**备份密码**。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR scanné · enveloppe chiffrée de %1$lld caractères reçue.\nSaisis maintenant uniquement le **mot de passe de sauvegarde**."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR স্ক্যান হয়েছে · %1$lld অক্ষরের এনক্রিপ্টেড এনভেলপ পাওয়া গেছে।\nএখন শুধু **ব্যাকআপ পাসওয়ার্ড** দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR escaneado · envelope criptografado de %1$lld caracteres recebido.\nAgora digite apenas a **senha de backup**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR отсканирован · получен зашифрованный конверт из %1$lld символов.\nТеперь введите только **пароль резервной копии**."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR اسکین ہو گیا · %1$lld حروف کا مرمز شدہ لفافہ موصول ہوا۔\nاب صرف **بیک اپ پاس ورڈ** درج کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR dipindai · amplop terenkripsi %1$lld karakter diterima.\nSekarang masukkan hanya **kata sandi cadangan**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR gescannt · verschlüsselter Umschlag mit %1$lld Zeichen empfangen.\nGib jetzt nur noch das **Backup-Passwort** ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QRをスキャンしました · %1$lld文字の暗号化された封筒を受信しました。\n次に**バックアップパスワード**のみを入力してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ QR don scan · we receive encrypted envelope wey get %1$lld character.\nNow enter only the **backup password**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Đã quét QR · đã nhận phong bì mã hóa gồm %1$lld ký tự.\nBây giờ chỉ cần nhập **mật khẩu sao lưu**."
          }
        }
      }
    },
    "paste_replace_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: every existing entry is deleted and the ones in the envelope are written instead."
          }
        },
        "tr": {
