    "setup_test_nothing_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the cursor is in a text field on the computer. If still nothing appears, remove the pairing on both sides and run the wizard again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin bilgisayarda bir metin alanında olduğundan emin ol. Yine bir şey çıkmıyorsa eşleşmeyi iki taraftan da kaldır ve sihirbazı baştan çalıştır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el cursor esté en un campo de texto del ordenador. Si sigue sin aparecer nada, quita el emparejamiento en ambos lados y vuelve a ejecutar el asistente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करें कि कर्सर कंप्यूटर पर किसी टेक्स्ट फ़ील्ड में है। फिर भी कुछ न दिखे, तो दोनों तरफ़ से पेयरिंग हटाएँ और विज़ार्ड फिर से चलाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكّد من أن المؤشر في حقل نصي على الحاسوب. وإن لم يظهر شيء رغم ذلك، فأزل الاقتران من الطرفين وشغّل المعالج من جديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认光标位于电脑上的文本框中。如果仍然没有任何内容出现，请在双方都移除配对，然后重新运行向导。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que le curseur se trouve dans un champ de texte sur l'ordinateur. Si rien n'apparaît toujours, supprime l'appairage des deux côtés et relance l'assistant."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে কার্সারটি কোনো টেক্সট ফিল্ডে আছে কি না নিশ্চিত হন। তারপরও কিছু দেখা না গেলে, দুই পাশেই জোড়া লাগানো তুলে ফেলুন এবং উইজার্ডটি আবার চালান।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o cursor está em um campo de texto no computador. Se ainda assim nada aparecer, remova o pareamento nos dois lados e execute o assistente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что курсор стоит в текстовом поле на компьютере. Если по-прежнему ничего не появляется, удалите сопряжение с обеих сторон и запустите мастер заново."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ کرسر کمپیوٹر پر کسی ٹیکسٹ فیلڈ میں ہے۔ اگر پھر بھی کچھ ظاہر نہ ہو تو دونوں طرف سے جوڑا ہٹائیں اور ویزرڈ دوبارہ چلائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan kursor berada di kolom teks di komputer. Jika masih tidak muncul apa-apa, hapus pemasangan di kedua sisi dan jalankan wizard lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass der Cursor am Computer in einem Textfeld steht. Erscheint weiterhin nichts, entferne die Kopplung auf beiden Seiten und starte den Assistenten erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルがコンピューター上のテキストフィールドにあることを確認してください。それでも何も表示されない場合は、両側でペアリングを解除し、ウィザードをもう一度実行してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure say the cursor dey inside text field for the computer. If nothing still show, remove the pairing from both sides and run the wizard again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đảm bảo con trỏ đang nằm trong một trường văn bản trên máy tính. Nếu vẫn không có gì hiện ra, hãy gỡ ghép nối ở cả hai phía và chạy lại trình hướng dẫn."
          }
        }
      }
    },
