    "settings_pin_disable_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the PIN is off, entries open with the master password / fingerprint alone. You do not need to remember the PIN: the master password is enough. Re-enable the fingerprint afterwards."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN kapatılınca kayıtlar yalnız ana parola/parmak izi ile açılır. PIN'i hatırlaman gerekmiyor: ana parola yeter. İşlem sonrası parmak izini yeniden etkinleştir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez desactivado el PIN, las entradas se abren solo con la contraseña maestra o la huella. No necesitas recordar el PIN: la contraseña maestra basta. Vuelve a activar la huella después."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN बंद होने के बाद, एंट्री केवल मास्टर पासवर्ड / फ़िंगरप्रिंट से खुलती हैं। PIN याद रखने की ज़रूरत नहीं: मास्टर पासवर्ड काफ़ी है। इसके बाद फ़िंगरप्रिंट फिर से चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إيقاف PIN، تُفتح المدخلات بكلمة المرور الرئيسية أو البصمة وحدهما. لست بحاجة لتذكّر PIN: تكفي كلمة المرور الرئيسية. فعّل البصمة مجددًا بعد ذلك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 PIN 后，条目仅凭主密码或指纹即可打开。你无需记住 PIN：主密码就足够。之后需要重新启用指纹。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois le PIN désactivé, les entrées s'ouvrent avec le seul mot de passe principal ou l'empreinte. Tu n'as pas besoin de te souvenir du PIN : le mot de passe principal suffit. Réactive ensuite l'empreinte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN বন্ধ হয়ে গেলে, শুধু মূল পাসওয়ার্ড বা ফিঙ্গারপ্রিন্ট দিয়েই এন্ট্রি খোলে। PIN মনে রাখার দরকার নেই: মূল পাসওয়ার্ডই যথেষ্ট। পরে ফিঙ্গারপ্রিন্ট আবার চালু করতে হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que o PIN for desativado, os itens abrem apenas com a senha principal ou a impressão digital. Você não precisa lembrar o PIN: a senha principal basta. Reative a impressão digital depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выключения PIN-кода записи открываются только основным паролем или отпечатком. PIN-код запоминать не нужно: основного пароля достаточно. После этого нужно снова включить отпечаток."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN بند کرنے کے بعد، اندراجات صرف ماسٹر پاس ورڈ یا فنگر پرنٹ سے کھلتے ہیں۔ آپ کو PIN یاد رکھنے کی ضرورت نہیں: ماسٹر پاس ورڈ کافی ہے۔ اس کے بعد آپ کو فنگر پرنٹ دوبارہ فعال کرنا ہوگا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah PIN dinonaktifkan, entri hanya bisa dibuka dengan kata sandi utama atau sidik jari. Kamu tidak perlu mengingat PIN: kata sandi utama sudah cukup. Aktifkan lagi sidik jari setelah ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem der PIN deaktiviert wurde, öffnen sich Einträge nur noch mit dem Hauptpasswort oder dem Fingerabdruck. Du musst dir keinen PIN merken: Das Hauptpasswort reicht aus. Aktiviere den Fingerabdruck danach erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINを無効にすると、アイテムはマスターパスワードまたは指紋のみで開くようになります。PINを覚えておく必要はありません。マスターパスワードだけで十分です。この後、指紋を再度有効にする必要があります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "After you turn off the PIN, entries go open with only master password or fingerprint. You no need remember PIN: master password dey enough. You go need turn on fingerprint again after dis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi tắt PIN, các mục sẽ chỉ mở được bằng mật khẩu chính hoặc vân tay. Bạn không cần nhớ PIN nữa: mật khẩu chính là đủ. Bạn sẽ cần bật lại vân tay sau đó."
          }
        }
      }
    },
    "settings_pin_heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN (second gate for the fingerprint)"
          }
        },
        "tr": {
