    "setup_prep_hid_slow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking long? Turn Bluetooth off and on again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun mu sürdü? Bluetooth'u kapatıp yeniden aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tarda mucho? Apaga el Bluetooth y vuelve a encenderlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा समय लग रहा है? ब्लूटूथ बंद करके फिर से चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل طال الانتظار؟ أطفئ البلوتوث ثم شغّله مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待太久？请关闭蓝牙后再重新开启。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça prend du temps ? Désactive puis réactive le Bluetooth."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক সময় লাগছে? ব্লুটুথ বন্ধ করে আবার চালু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está demorando? Desative o Bluetooth e ative de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком долго? Выключите и снова включите Bluetooth."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ دیر لگ رہی ہے؟ بلوٹوتھ بند کر کے دوبارہ آن کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh waktu lama? Matikan Bluetooth, lalu nyalakan lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert es lange? Schalte Bluetooth aus und wieder ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかっていますか？ Bluetoothを一度オフにしてから、もう一度オンにしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey take long? Turn Bluetooth off, then turn am on again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất nhiều thời gian? Hãy tắt Bluetooth rồi bật lại."
          }
        }
      }
    },
