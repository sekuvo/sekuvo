    "settings_import_replace_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: every existing entry is deleted and the ones in the backup are written instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat: mevcut tüm kayıtlar silinip yedektekiler yazılır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: se elimina cada entrada existente y se escriben en su lugar las de la copia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी: हर मौजूदा एंट्री मिटा दी जाएगी और बैकअप वाली एंट्री उनकी जगह लिखी जाएँगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: ستُحذف كل مدخلة موجودة وتُكتب مكانها مدخلات النسخة الاحتياطية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：所有现有条目将被删除，并替换为备份中的条目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : chaque entrée existante est supprimée et remplacée par celles de la sauvegarde."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা: বিদ্যমান প্রতিটি এন্ট্রি মুছে গিয়ে ব্যাকআপের এন্ট্রিগুলো লেখা হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: todos os itens existentes serão excluídos e substituídos pelos do backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание: все существующие записи будут удалены и заменены записями из резервной копии."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انتباہ: تمام موجودہ اندراجات حذف کر کے بیک اپ کے اندراجات سے تبدیل کر دیے جائیں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan: semua entri yang ada akan dihapus dan digantikan oleh entri dari cadangan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Jeder bestehende Eintrag wird gelöscht und durch die des Backups ersetzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告: 既存のすべてのアイテムが削除され、バックアップの内容に置き換わります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: every entry wey dey there before go delete and the backup own go replace am."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo: mọi mục hiện có sẽ bị xóa và thay thế bằng các mục trong bản sao lưu."
          }
        }
      }
    },
