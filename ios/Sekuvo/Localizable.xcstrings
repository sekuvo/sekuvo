    "settings_keyboard_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you enable the keyboard add-on, you can pick Sekuvo Keyboard from the keyboard switcher in any app and type your saved details straight into the field."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye eklentisini etkinleştirirsen herhangi bir uygulamada klavye değiştiriciden Sekuvo Klavyesi'ni seçip kayıtlı bilgilerini doğrudan ilgili alana yazdırabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activas el complemento de teclado, puedes elegir Teclado Sekuvo en el selector de teclados de cualquier aplicación y escribir tus datos guardados directamente en el campo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड ऐड-ऑन चालू करने पर, किसी भी ऐप में कीबोर्ड स्विचर से «Sekuvo कीबोर्ड» चुनकर अपने सहेजे विवरण सीधे फ़ील्ड में टाइप कर सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيل إضافة لوحة المفاتيح، يمكنك اختيار «لوحة مفاتيح Sekuvo» من مبدّل لوحات المفاتيح في أي تطبيق وكتابة بياناتك المحفوظة مباشرة في الحقل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果启用键盘附加组件，你可以在任何应用的键盘切换器中选择 Sekuvo 键盘，并将已保存的信息直接输入到字段中。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu actives le module clavier, tu peux choisir Clavier Sekuvo dans le sélecteur de clavier de n'importe quelle application et saisir directement tes informations enregistrées dans le champ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীবোর্ড অ্যাড-অন চালু করলে, যেকোনো অ্যাপের কীবোর্ড সুইচার থেকে Sekuvo কীবোর্ড বেছে নিয়ে সংরক্ষিত তথ্য সরাসরি ফিল্ডে টাইপ করতে পারবেন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ativar o complemento de teclado, pode escolher o Teclado Sekuvo no seletor de teclado de qualquer aplicativo e digitar seus dados salvos diretamente no campo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы включите дополнение клавиатуры, вы сможете выбрать Клавиатуру Sekuvo в переключателе клавиатур в любом приложении и вводить сохранённые данные прямо в поле."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کی بورڈ ایڈ آن فعال کرنے پر، آپ کسی بھی ایپ میں کی بورڈ سوئچر سے «Sekuvo کی بورڈ» منتخب کر سکتے ہیں اور محفوظ کردہ ڈیٹا براہ راست فیلڈ میں ٹائپ کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu mengaktifkan tambahan keyboard, kamu bisa memilih Keyboard Sekuvo dari pemilih keyboard di aplikasi mana pun dan mengetik data tersimpanmu langsung ke kolom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Tastaturerweiterung aktivierst, kannst du in jeder App über den Tastaturwechsler die Sekuvo-Tastatur auswählen und deine gespeicherten Daten direkt in das Feld eingeben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード拡張機能を有効にすると、どのアプリでもキーボード切り替えからSekuvoキーボードを選択し、保存したデータをフィールドに直接入力できます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn on the keyboard add-on, you fit choose Sekuvo Keyboard from the keyboard switcher for any app and type your saved data straight inside the field."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn bật tiện ích bàn phím, bạn có thể chọn Bàn phím Sekuvo từ bộ chuyển đổi bàn phím trong bất kỳ ứng dụng nào và nhập dữ liệu đã lưu trực tiếp vào trường."
          }
        }
      }
    },
