    "log_clear_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the entire log? This cannot be undone; the entries themselves are not affected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğün tamamı silinsin mi? Geri alınamaz; kayıtların kendisi etkilenmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todo el registro? No se puede deshacer; las entradas en sí no se ven afectadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा लॉग मिटाएँ? इसे वापस नहीं किया जा सकता; एंट्री खुद प्रभावित नहीं होतीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف السجل بالكامل؟ لا يمكن التراجع عن هذا؛ المدخلات نفسها لا تتأثر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除整个记录？此操作无法撤销；条目本身不受影响。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tout le journal ? Cette action est irréversible ; les entrées elles-mêmes ne sont pas affectées."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরো লগ মুছে দেবেন? এটি ফিরিয়ে আনা যাবে না; এন্ট্রিগুলো এতে প্রভাবিত হবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir todo o registro? Isso não pode ser desfeito; os itens em si não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить весь журнал? Это нельзя отменить; сами записи не пострадают."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پورا لاگ حذف کریں؟ اسے واپس نہیں لایا جا سکتا؛ اندراجات خود متاثر نہیں ہوں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus seluruh log? Ini tidak bisa dibatalkan; entri itu sendiri tidak terpengaruh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesamte Protokoll löschen? Dies kann nicht rückgängig gemacht werden; die Einträge selbst sind nicht betroffen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をすべて削除しますか？ この操作は元に戻せません。アイテム自体には影響しません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the whole log? You no fit undo dis one; the entries demself no go affect."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa toàn bộ nhật ký? Việc này không thể hoàn tác; bản thân các mục không bị ảnh hưởng."
          }
        }
      }
