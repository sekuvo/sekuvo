    "setup_notepad_macos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the computer, open TextEdit (⌘ + Space → TextEdit) and put the cursor in a new document."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarda TextEdit'i aç (⌘ + Boşluk → TextEdit) ve imleci yeni bir belgeye koy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el ordenador, abre TextEdit (⌘ + Espacio → TextEdit) y pon el cursor en un documento nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर पर TextEdit खोलें (⌘ + स्पेस → TextEdit) और कर्सर एक नए दस्तावेज़ में रखें।"
          }
