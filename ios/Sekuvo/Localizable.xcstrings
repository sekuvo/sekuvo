    "bt_speed_result_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nThe computer must show 10 space-separated groups, each of them exactly %2$@ — if even one differs, pick the next slower speed and repeat the test."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nBilgisayarda boşlukla ayrılmış 10 grup olmalı ve her biri birebir %2$@ — biri bile farklıysa bir alt hızı seç ve testi tekrarla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nEl ordenador debe mostrar 10 grupos separados por espacios, cada uno exactamente %2$@ — si aunque sea uno difiere, elige la siguiente velocidad más lenta y repite la prueba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nकंप्यूटर पर स्पेस से अलग 10 समूह दिखने चाहिए, हर एक ठीक %2$@ का — एक भी अलग हो तो अगली धीमी गति चुनें और परीक्षण दोहराएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nيجب أن يظهر في الحاسوب 10 مجموعات مفصولة بمسافات، كل واحدة %2$@ بالضبط — إن اختلفت واحدة فقط، اختر السرعة الأبطأ التالية وكرّر الاختبار."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n电脑上必须显示 10 组以空格分隔的内容，每组都恰好是 %2$@ — 只要有一组不同，就选择更慢一档的速度并重复测试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nL'ordinateur doit afficher 10 groupes séparés par des espaces, chacun exactement %2$@ — si ne serait-ce qu'un seul diffère, choisis la vitesse inférieure suivante et répète le test."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nকম্পিউটারে স্পেস দিয়ে আলাদা করা ১০টি গ্রুপ দেখাতে হবে, প্রতিটি ঠিক %2$@ — একটিও ভিন্ন হলে পরের ধীরগতি বেছে টেস্টটি আবার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nO computador deve mostrar 10 grupos separados por espaço, cada um com exatamente %2$@ — se ao menos um for diferente, escolha a próxima velocidade mais lenta e repita o teste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nНа компьютере должно появиться 10 групп, разделённых пробелами, каждая ровно по %2$@ — если хотя бы одна отличается, выберите следующую более низкую скорость и повторите тест."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nکمپیوٹر پر خالی جگہ سے الگ کیے گئے 10 گروپ ظاہر ہونے چاہئیں، ہر ایک بالکل %2$@ کا — اگر ایک بھی مختلف ہو، اگلی کم رفتار منتخب کریں اور دوبارہ ٹیسٹ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nKomputer harus menampilkan 10 kelompok yang dipisahkan spasi, masing-masing persis %2$@ — jika hanya satu yang berbeda, pilih kecepatan lebih rendah berikutnya dan ulangi tes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nAm Computer sollten 10 durch Leerzeichen getrennte Gruppen erscheinen, jede genau %2$@ — weicht auch nur eine ab, wähle die nächstniedrigere Geschwindigkeit und wiederhole den Test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nコンピューターにはスペースで区切られた10個のグループが表示され、それぞれちょうど%2$@になるはずです — 1つでも異なる場合は、次に低い速度を選んでテストを繰り返してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nThe computer must show 10 group wey space separate, each one exactly %2$@ — if even one different, choose the next slower speed and repeat the test."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nMáy tính phải hiển thị 10 nhóm được phân tách bằng dấu cách, mỗi nhóm chính xác %2$@ — nếu dù chỉ một nhóm khác biệt, hãy chọn tốc độ chậm hơn kế tiếp và lặp lại thử nghiệm."
          }
        }
      }
    },
