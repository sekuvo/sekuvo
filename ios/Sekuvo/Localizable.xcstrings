    "settings_layouts_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the layouts you actually use. Only the ones you tick appear when you type a secret to a computer — the rest stay out of your way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekten kullandığın düzenleri seç. Bilgisayara sır yazarken yalnız işaretlediklerin çıkar, diğerleri yoluna çıkmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las distribuciones que realmente usas. Solo las marcadas aparecen al escribir un secreto en un ordenador — el resto no estorba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो लेआउट आप सच में इस्तेमाल करते हैं वे चुनें। किसी कंप्यूटर पर राज़ टाइप करते समय केवल टिक किए लेआउट दिखते हैं — बाक़ी आपके रास्ते में नहीं आते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التخطيطات التي تستخدمها فعلًا. لا يظهر عند كتابة سرّ في حاسوب إلا ما حدّدته منها — والباقي لا يعترض طريقك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你实际使用的布局。只有勾选的布局会出现在向电脑输入密码时的选项中 — 其余的不会打扰你。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les dispositions que tu utilises vraiment. Seules celles cochées apparaissent quand tu saisis un secret sur un ordinateur — les autres restent en retrait."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আসলে যে লেআউটগুলো ব্যবহার করেন সেগুলো বেছে নিন। কম্পিউটারে কোনো সিক্রেট টাইপ করার সময় শুধু টিক দেওয়া লেআউটগুলো দেখা যায় — বাকিগুলো আড়ালে থাকে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os layouts que você realmente usa. Só os marcados aparecem ao digitar um segredo em um computador — os demais ficam fora do caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите раскладки, которыми вы реально пользуетесь. При вводе секрета на компьютере появятся только отмеченные — остальные не будут мешать."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ لے آؤٹس منتخب کریں جو آپ واقعی استعمال کرتے ہیں۔ کمپیوٹر پر راز ٹائپ کرتے وقت صرف وہی ظاہر ہوں گے جو آپ نے منتخب کیے ہیں — باقی راستے میں نہیں آئیں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tata letak yang benar-benar kamu gunakan. Hanya yang dicentang yang muncul saat mengetik rahasia di komputer — sisanya tidak menghalangi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Layouts, die du tatsächlich verwendest. Nur die angehakten erscheinen, wenn du ein Geheimnis an einem Computer eingibst — die übrigen stören nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に使用しているレイアウトを選択してください。コンピューターに秘密情報を入力する際は、チェックしたものだけが表示され、それ以外は邪魔になりません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the layouts wey you dey really use. Na only the ones you tick go show when you dey type secret for computer — the rest no go disturb you."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn các bố cục mà bạn thực sự sử dụng. Chỉ những bố cục bạn đã đánh dấu mới xuất hiện khi bạn nhập bí mật trên máy tính — các bố cục còn lại sẽ không gây vướng víu."
          }
        }
      }
    },
