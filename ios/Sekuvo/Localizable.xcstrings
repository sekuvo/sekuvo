    "bt_sensitive_chars": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text contains layout-sensitive characters: %1$@ — I recommend typing the test before you send it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metinde düzene duyarlı karakterler var: %1$@ — göndermeden önce test yazmanı öneririm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto contiene caracteres sensibles a la distribución: %1$@ — te recomiendo escribir la prueba antes de enviarlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टेक्स्ट में लेआउट-संवेदनशील अक्षर हैं: %1$@ — भेजने से पहले परीक्षण टाइप करने की सलाह है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا النص على محارف حسّاسة للتخطيط: %1$@ — يُنصح بكتابة الاختبار قبل الإرسال."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文本包含对布局敏感的字符：%1$@ — 建议发送前先输入测试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte contient des caractères sensibles à la disposition : %1$@ — je recommande de saisir le test avant de l'envoyer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লেখায় লেআউট-সংবেদনশীল অক্ষর আছে: %1$@ — পাঠানোর আগে টেস্ট টাইপ করে দেখার পরামর্শ দিচ্ছি।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto contém caracteres sensíveis ao layout: %1$@ — recomendo digitar o teste antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот текст содержит символы, чувствительные к раскладке: %1$@ — рекомендуем ввести тест перед отправкой."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس متن میں لے آؤٹ کے حساس حروف ہیں: %1$@ — بھیجنے سے پہلے ٹیسٹ ٹائپ کرنے کی سفارش کی جاتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks ini berisi karakter yang sensitif terhadap tata letak: %1$@ — disarankan mengetik tes sebelum mengirim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text enthält layoutempfindliche Zeichen: %1$@ — es wird empfohlen, vor dem Senden den Test einzugeben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
