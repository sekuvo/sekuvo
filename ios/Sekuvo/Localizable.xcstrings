    "unlock_pin_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN. Without this code the entries cannot be decrypted — the master password alone is not enough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN kodunu gir. Bu kod olmadan kayıtlar çözülemez — ana parola tek başına yetmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu PIN. Sin este código las entradas no se pueden descifrar — la contraseña maestra sola no basta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना PIN डालें। इस कोड के बिना एंट्री डिक्रिप्ट नहीं हो सकतीं — अकेला मास्टर पासवर्ड काफ़ी नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل PIN الخاص بك. بدون هذا الرمز لا يمكن فكّ تشفير المدخلات — كلمة المرور الرئيسية وحدها لا تكفي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你的 PIN。没有此代码，条目无法解密 — 仅凭主密码是不够的。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis ton PIN. Sans ce code, les entrées ne peuvent pas être déchiffrées — le mot de passe principal seul ne suffit pas."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার PIN দিন। এই কোড ছাড়া এন্ট্রিগুলো ডিক্রিপ্ট করা যাবে না — শুধু মূল পাসওয়ার্ড যথেষ্ট নয়।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu PIN. Sem este código, os itens não podem ser descriptografados — a senha principal sozinha não é suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите PIN-код. Без этого кода записи невозможно расшифровать — одного основного пароля недостаточно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا PIN درج کریں۔ اس کوڈ کے بغیر اندراجات کو ڈی کرپٹ نہیں کیا جا سکتا — صرف ماسٹر پاس ورڈ کافی نہیں ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan PIN-mu. Tanpa kode ini entri tidak bisa didekripsi — kata sandi utama saja tidak cukup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen PIN ein. Ohne diesen Code können Einträge nicht entschlüsselt werden — das Hauptpasswort allein reicht nicht aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINを入力してください。このコードがないとアイテムを復号できません — マスターパスワードだけでは不十分です。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN. Without dis code, entries no fit decrypt — master password alone no dey enough."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập PIN của bạn. Nếu không có mã này, các mục không thể giải mã được — chỉ riêng mật khẩu chính là không đủ."
          }
        }
      }
    },
