    "old_passwords_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept when the password changes, with the date it was replaced. Tap the eye to reveal one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola değiştikçe eskisi, değiştirildiği tarihle burada kalır. Görmek için göz simgesine dokun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan al cambiar la contraseña, junto con la fecha en que se reemplazó. Toca el ojo para revelar una."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड बदलने पर पुराना, बदले जाने की तारीख के साथ यहाँ रहता है। देखने के लिए आँख के निशान पर टैप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ عند تغيير كلمة المرور مع تاريخ استبدالها. المس رمز العين لإظهار واحدة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码更改时保留旧密码及其被替换的日期。点击眼睛图标可显示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés lors d'un changement de mot de passe, avec la date de remplacement. Touche l'œil pour en révéler un."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ড বদলালে পুরোনোটি, বদলের তারিখসহ এখানে থাকে। দেখতে চোখের আইকনে চাপ দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas quando a senha muda, com a data da substituição. Toque no olho para revelar uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются при смене пароля вместе с датой замены. Нажмите на глаз, чтобы показать."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس ورڈ بدلنے پر پرانا، تبدیلی کی تاریخ کے ساتھ یہاں رہتا ہے۔ دیکھنے کے لیے آنکھ کے نشان کو چھوئیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan saat kata sandi berubah, beserta tanggal penggantiannya. Ketuk ikon mata untuk menampilkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden bei einem Passwortwechsel behalten, mit dem Datum der Ablösung. Tippe auf das Auge, um eines anzuzeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更すると、置き換えられた日付とともにここに残ります。目のアイコンをタップすると表示されます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem dey keep am when password change, with the date wey dem replace am. Tap the eye make you see one."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được giữ lại khi mật khẩu thay đổi, kèm ngày bị thay thế. Chạm vào biểu tượng mắt để hiện ra."
          }
        }
      }
    },
