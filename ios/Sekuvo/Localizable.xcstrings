    "setup_notepad_chromeos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the computer, open any text field (e.g. a note or a document) and put the cursor in it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarda herhangi bir metin alanı aç (ör. bir not ya da belge) ve imleci içine koy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el ordenador, abre cualquier campo de texto (p. ej. una nota o un documento) y pon el cursor dentro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर पर कोई भी टेक्स्ट फ़ील्ड खोलें (जैसे कोई नोट या दस्तावेज़) और कर्सर उसमें रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي حقل نصي على الحاسوب (مثل ملاحظة أو مستند) وضع المؤشر داخله."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开任意文本框（例如笔记或文档），并将光标放在其中。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'ordinateur, ouvre n'importe quel champ de texte (p. ex. une note ou un document) et place le curseur dedans."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে যেকোনো টেক্সট ফিল্ড খুলুন (যেমন একটি নোট বা ডকুমেন্ট) এবং এর ভেতরে কার্সার রাখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador, abra qualquer campo de texto (por exemplo, uma nota ou um documento) e coloque o cursor nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере откройте любое текстовое поле (например, заметку или документ) и поместите в него курсор."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر پر کوئی بھی ٹیکسٹ فیلڈ کھولیں (مثلاً کوئی نوٹ یا دستاویز) اور کرسر اس میں رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di komputer, buka kolom teks apa saja (misalnya catatan atau dokumen) dan letakkan kursor di dalamnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne am Computer ein beliebiges Textfeld (z. B. eine Notiz oder ein Dokument) und setze den Cursor hinein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターで任意のテキストフィールド（例: メモやドキュメント）を開き、その中にカーソルを置いてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "For the computer, open any text field (like note or document) and put the cursor inside am."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên máy tính, hãy mở một trường văn bản bất kỳ (ví dụ một ghi chú hoặc tài liệu) và đặt con trỏ vào đó."
          }
        }
      }
    },
