    "bt_speed_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keystrokes are sent one by one. If the speed is higher than the connection can carry, typing stops (no characters are lost) — use the speed test to measure which one works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşlar tek tek gönderilir. Hız, bağlantının taşıyabileceğinden yüksek olursa yazma durur (karakter kaybolmaz) — hangisinin çalıştığını hız testiyle ölç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pulsaciones se envían una a una. Si la velocidad es mayor de lo que la conexión soporta, la escritura se detiene (no se pierde ningún carácter) — usa la prueba de velocidad para medir cuál funciona."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजियाँ एक-एक कर भेजी जाती हैं। अगर गति कनेक्शन की क्षमता से ज़्यादा हो, तो टाइपिंग रुक जाती है (कोई अक्षर खोता नहीं) — कौन-सी गति काम करती है, यह गति परीक्षण से मापें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل ضغطات المفاتيح واحدة تلو الأخرى. إن كانت السرعة أعلى مما يحتمله الاتصال، تتوقّف الكتابة (لا يُفقد أي محرف) — استخدم اختبار السرعة لمعرفة أيّها يعمل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键逐个发送。如果速度超过连接的承受能力，输入会停止（不会丢失字符）— 用速度测试来确定哪个速度可行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frappes sont envoyées une par une. Si la vitesse dépasse ce que la connexion peut supporter, la saisie s'arrête (aucun caractère n'est perdu) — utilise le test de vitesse pour mesurer ce qui fonctionne."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীস্ট্রোকগুলো একে একে পাঠানো হয়। সংযোগ যতটা বহন করতে পারে তার চেয়ে গতি বেশি হলে টাইপিং থেমে যায় (কোনো অক্ষর হারায় না) — কোনটা কাজ করে তা মাপতে স্পিড টেস্ট ব্যবহার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas são enviadas uma a uma. Se a velocidade for maior do que a conexão suporta, a digitação para (nenhum caractere é perdido) — use o teste de velocidade para medir o que funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатия клавиш отправляются по одному. Если скорость выше, чем может выдержать соединение, ввод останавливается (символы не теряются) — используйте тест скорости, чтобы определить рабочий вариант."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کی اسٹروکس ایک ایک کر کے بھیجے جاتے ہیں۔ اگر رفتار کنکشن کی برداشت سے زیادہ ہو تو ٹائپنگ رک جاتی ہے (کوئی حرف ضائع نہیں ہوتا) — یہ جاننے کے لیے کہ کون سی رفتار کام کرتی ہے اسپیڈ ٹیسٹ استعمال کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol dikirim satu per satu. Jika kecepatan melebihi kemampuan koneksi, pengetikan berhenti (tidak ada karakter yang hilang) — gunakan tes kecepatan untuk mengetahui mana yang berfungsi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenanschläge werden einzeln gesendet. Ist die Geschwindigkeit höher, als die Verbindung verträgt, stoppt die Eingabe (kein Zeichen geht verloren) — nutze den Geschwindigkeitstest, um herauszufinden, was funktioniert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー入力は1つずつ送信されます。接続が処理できる速度を超えると入力が停止します（文字が失われることはありません）— 速度テストでどれが使えるか確認してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Every key press dey send one by one. If the speed pass wetin the connection fit carry, the typing go stop (no character go lost) — use the speed test to see wetin dey work."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần nhấn phím được gửi từng cái một. Nếu tốc độ vượt quá khả năng chịu đựng của kết nối, việc nhập liệu sẽ dừng lại (không mất ký tự nào) — hãy dùng thử nghiệm tốc độ để biết tốc độ nào phù hợp."
          }
        }
      }
    },
