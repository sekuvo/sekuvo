    "transfer_envelope_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted envelope field is empty — publish on the computer, scan the QR and tap \"Get from clipboard\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli zarf alanı boş — bilgisayarda yayınla, QR'ı okut ve \"Panodan al\"a bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo del sobre cifrado está vacío — publica en el ordenador, escanea el QR y toca «Obtener del portapapeles»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्टेड लिफ़ाफ़ा फ़ील्ड ख़ाली है — कंप्यूटर पर प्रकाशित करें, QR स्कैन करें और «क्लिपबोर्ड से लें» दबाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقل المظروف المشفَّر فارغ — انشر على الحاسوب، امسح QR، واضغط «الحصول من الحافظة»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密信封字段为空 — 请先在电脑上发布，扫描二维码，然后点击“从剪贴板获取”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ de l'enveloppe chiffrée est vide — publie sur l'ordinateur, scanne le QR et touche « Obtenir depuis le presse-papiers »."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এনক্রিপ্টেড এনভেলপ ফিল্ডটি খালি — কম্পিউটারে প্রকাশ করুন, QR স্ক্যান করুন এবং “ক্লিপবোর্ড থেকে নিন” চাপুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O campo do envelope criptografado está vazio — publique no computador, escaneie o QR e toque em “Obter da área de transferência”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле зашифрованного конверта пусто — опубликуйте на компьютере, отсканируйте QR и нажмите «Получить из буфера обмена»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرمز شدہ لفافے کا فیلڈ خالی ہے — کمپیوٹر پر شائع کریں، QR اسکین کریں، اور «کلپ بورڈ سے حاصل کریں» دبائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom amplop terenkripsi kosong — publikasikan di komputer, pindai QR, dan ketuk “Ambil dari papan klip”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Feld für den verschlüsselten Umschlag ist leer — veröffentliche am Computer, scanne den QR und tippe auf „Aus Zwischenablage übernehmen“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された封筒のフィールドが空です — コンピューターで公開し、QRをスキャンして「クリップボードから取得」をタップしてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted envelope field empty — publish am for the computer, scan the QR, and tap “Get from clipboard”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường phong bì mã hóa đang trống — hãy công bố trên máy tính, quét mã QR, và chạm vào “Lấy từ bộ nhớ tạm”."
          }
        }
      }
    },
