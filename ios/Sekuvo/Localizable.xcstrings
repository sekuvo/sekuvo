    "home_tags_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tags yet. You can add one below."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz etiket yok. Aşağıdan ekleyebilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay etiquetas. Puedes añadir una debajo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई टैग नहीं। नीचे से एक जोड़ सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا وسوم بعد. يمكنك إضافة واحد أدناه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无标签，可在下方添加。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune étiquette pour l'instant. Tu peux en ajouter une ci-dessous."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো ট্যাগ নেই। নিচে একটি যোগ করতে পারেন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há etiquetas. Você pode adicionar uma abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меток пока нет. Вы можете добавить одну ниже."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی ٹیگ نہیں۔ آپ نیچے ایک شامل کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada label. Kamu bisa menambahkannya di bawah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Tags. Du kannst unten eines hinzufügen."
