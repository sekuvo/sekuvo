          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'ordinateur, ouvre le Bloc-notes (tape « bloc-notes » dans le menu Démarrer) et place le curseur dedans."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পিউটারে নোটপ্যাড খুলুন (স্টার্ট মেনুতে “notepad” লিখুন) এবং এর ভেতরে কার্সার রাখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador, abra o Bloco de Notas (digite “bloco de notas” no menu Iniciar) e coloque o cursor nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере откройте Блокнот (введите «блокнот» в меню «Пуск») и поместите в него курсор."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر پر Notepad کھولیں (Start میں «notepad» ٹائپ کریں) اور کرسر اس میں رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di komputer, buka Notepad (ketik “notepad” di Mulai) dan letakkan kursor di dalamnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne am Computer den Editor (gib im Startmenü „Editor“ ein) und setze den Cursor hinein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターでメモ帳を開き（スタートで「メモ帳」と入力）、その中にカーソルを置いてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "For the computer, open Notepad (type “notepad” for Start) and put the cursor inside am."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên máy tính, hãy mở Notepad (nhập “notepad” vào menu Bắt đầu) và đặt con trỏ vào đó."
          }
        }
      }
    },
    "setup_os_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menus on the computer differ by system, so I'll show you the right path."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayardaki menüler sisteme göre değişir; sana doğru yolu göstereyim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús del ordenador cambian según el sistema, así que te mostraré el camino correcto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर के मेनू हर सिस्टम में अलग होते हैं, इसलिए यहाँ आपके सिस्टम का सही रास्ता दिखाया जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف قوائم الحاسوب باختلاف النظام، لذا سأريك المسار الصحيح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不同系统的电脑菜单各不相同，我会告诉你正确的路径。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les menus de l'ordinateur diffèrent selon le système, alors je vais te montrer le bon chemin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেমভেদে কম্পিউটারের মেনু আলাদা হয়, তাই আমি আপনাকে সঠিক পথটি দেখাব।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os menus do computador mudam de um sistema para outro, então vou mostrar o caminho certo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню на компьютере отличаются в разных системах, поэтому я покажу вам нужный путь."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر کے مینو ہر سسٹم میں مختلف ہوتے ہیں، اس لیے آپ کو صحیح راستہ دکھایا جائے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu di komputer berbeda-beda tergantung sistemnya, jadi kamu akan ditunjukkan jalur yang tepat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüs am Computer unterscheiden sich je nach System, deshalb zeige ich dir den passenden Weg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターのメニューはOSによって異なるため、お使いのOSに合った手順を表示します。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The menus for computer dey different from one system to another, so we go show you the correct way."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các menu trên máy tính khác nhau tùy theo hệ thống, vì vậy tôi sẽ chỉ cho bạn đúng đường dẫn."
          }
        }
      }
    },
