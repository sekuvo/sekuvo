    "paste_err_envelope_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted envelope field is empty — paste it with \"Get from clipboard\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli zarf alanı boş — \"Panodan al\" ile yapıştır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo del sobre cifrado está vacío — pégalo con «Obtener del portapapeles»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्टेड लिफ़ाफ़ा फ़ील्ड ख़ाली है — «क्लिपबोर्ड से लें» से चिपकाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقل المظروف المشفَّر فارغ — الصقه عبر «الحصول من الحافظة»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密信封字段为空 — 请用“从剪贴板获取”粘贴。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ de l'enveloppe chiffrée est vide — colle-la avec « Obtenir depuis le presse-papiers »."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এনক্রিপ্টেড এনভেলপ ফিল্ডটি খালি — “ক্লিপবোর্ড থেকে নিন” দিয়ে পেস্ট করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O campo do envelope criptografado está vazio — cole-o com “Obter da área de transferência”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле зашифрованного конверта пусто — вставьте его через «Получить из буфера обмена»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرمز شدہ لفافے کا فیلڈ خالی ہے — «کلپ بورڈ سے حاصل کریں» کے ذریعے پیسٹ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom amplop terenkripsi kosong — tempel dengan “Ambil dari papan klip”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Feld für den verschlüsselten Umschlag ist leer — füge ihn über „Aus Zwischenablage übernehmen“ ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された封筒のフィールドが空です — 「クリップボードから取得」で貼り付けてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted envelope field empty — paste am through “Get from clipboard”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường phong bì mã hóa đang trống — hãy dán nó qua “Lấy từ bộ nhớ tạm”."
          }
        }
      }
    },
