    "bt_stopped_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: %1$lld / %2$lld characters typed. The text on the computer is INCOMPLETE — delete it and start over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durduruldu: %1$lld / %2$lld karakter yazıldı. Bilgisayardaki metin EKSİK — sil ve baştan yaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: %1$lld / %2$lld caracteres escritos. El texto en el ordenador está INCOMPLETO — bórralo y empieza de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुका: %1$lld / %2$lld अक्षर टाइप हुए। कंप्यूटर पर टेक्स्ट अधूरा है — उसे मिटाकर फिर से शुरू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّفت: %1$lld / %2$lld محرفًا كُتبت. النص في الحاسوب غير مكتمل — احذفه وابدأ من جديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：已输入 %1$lld / %2$lld 个字符。电脑上的文本不完整 — 请删除后重新开始。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté : %1$lld / %2$lld caractères saisis. Le texte sur l'ordinateur est INCOMPLET — supprime-le et recommence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থেমে গেছে: %1$lld / %2$lld অক্ষর টাইপ হয়েছে। কম্পিউটারের লেখাটি অসম্পূর্ণ — মুছে আবার শুরু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido: %1$lld / %2$lld caracteres digitados. O texto no computador está INCOMPLETO — apague-o e comece de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено: введено %1$lld / %2$lld символов. Текст на компьютере НЕПОЛНЫЙ — удалите его и начните заново."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رک گیا: %1$lld / %2$lld حروف ٹائپ ہوئے۔ کمپیوٹر پر موجود متن نامکمل ہے — اسے حذف کر کے دوبارہ شروع کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti: %1$lld / %2$lld karakter diketik. Teks di komputer TIDAK LENGKAP — hapus dan mulai lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt: %1$lld / %2$lld Zeichen eingegeben. Der Text am Computer ist UNVOLLSTÄNDIG — lösche ihn und beginne neu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました: %1$lld / %2$lld文字を入力しました。コンピューター上のテキストは不完全です — 削除して最初からやり直してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E stop: %1$lld / %2$lld character wey dem type. The text for the computer no complete — delete am and start again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng: %1$lld / %2$lld ký tự đã nhập. Văn bản trên máy tính CHƯA HOÀN CHỈNH — hãy xóa nó và bắt đầu lại."
          }
        }
      }
