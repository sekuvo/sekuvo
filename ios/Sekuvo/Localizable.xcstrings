    "qr_permission_rationale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera permission is required. The image never leaves the device: the decoder is inside the app and the app has no network permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni gerekli. Görüntü cihazdan çıkmaz: çözücü uygulamanın içinde ve uygulamanın ağ izni yok."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere el permiso de cámara. La imagen nunca sale del dispositivo: el decodificador está dentro de la aplicación y esta no tiene permiso de red."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा अनुमति ज़रूरी है। इमेज कभी डिवाइस से बाहर नहीं जाती: डिकोडर ऐप के भीतर है और ऐप के पास नेटवर्क अनुमति नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الكاميرا مطلوب. الصورة لا تغادر الجهاز أبدًا: المفكّك داخل التطبيق والتطبيق لا يملك إذن الشبكة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要相机权限。图像不会离开设备：解码器就在应用内部，且应用没有网络权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La permission caméra est requise. L'image ne quitte jamais l'appareil : le décodeur est dans l'application, qui n'a pas de permission réseau."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা অনুমতি প্রয়োজন। ছবি কখনো ডিভাইস ছেড়ে যায় না: ডিকোডারটি অ্যাপের ভেতরেই আছে এবং অ্যাপটির নেটওয়ার্ক অনুমতি নেই।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de câmera é necessária. A imagem nunca sai do dispositivo: o decodificador está dentro do aplicativo, que não tem permissão de rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на камеру. Изображение никогда не покидает устройство: декодер находится внутри приложения, у которого нет разрешения на сеть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرے کی اجازت درکار ہے۔ تصویر کبھی ڈیوائس سے باہر نہیں جاتی: ڈی کوڈر ایپ کے اندر ہے، جس کے پاس نیٹ ورک کی اجازت نہیں ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin kamera diperlukan. Gambar tidak pernah keluar dari perangkat: dekoder ada di dalam aplikasi, yang tidak memiliki izin jaringan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kameraberechtigung wird benötigt. Das Bild verlässt niemals das Gerät: Der Decoder befindet sich in der App, die keine Netzwerkberechtigung besitzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限が必要です。画像が端末の外に出ることは決してありません: デコーダーはネットワーク権限を持たないアプリ内で動作します。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We need camera permission. The image no dey leave the device at all: the decoder dey inside the app, wey no get network permission."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có quyền camera. Hình ảnh không bao giờ rời khỏi thiết bị: bộ giải mã nằm bên trong ứng dụng, vốn không có quyền mạng."
          }
        }
      }
    },
