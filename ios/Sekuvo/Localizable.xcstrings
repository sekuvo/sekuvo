    "settings_usage_log_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which field of which entry went where, and when — to the clipboard, to a computer, or out through the keyboard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi kaydın hangi alanı, ne zaman, nereye gitti — panoya, bilgisayara ya da klavyeden. Bir bilgisayar ele geçtiğinde \"oraya ne gitti, neyi değiştirmeliyim\" sorusunun cevabı burada. Günlük kayıtlarla aynı anahtarla şifreli durur; değerlerin kendisi hiçbir koşulda yazılmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué campo de qué entrada fue a dónde, y cuándo — al portapapeles, a un ordenador, o a través del teclado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किस एंट्री का कौन-सा फ़ील्ड कब कहाँ गया — क्लिपबोर्ड पर, किसी कंप्यूटर पर, या कीबोर्ड के ज़रिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيّ حقل من أيّ مدخلة ذهب إلى أين، ومتى — إلى الحافظة، إلى حاسوب، أو عبر لوحة المفاتيح."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个条目的哪个字段、何时、发送到了哪里 — 剪贴板、电脑，或通过键盘输入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel champ de quelle entrée est allé où, et quand — vers le presse-papiers, vers un ordinateur, ou via le clavier."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন এন্ট্রির কোন ফিল্ড কখন কোথায় গেছে — ক্লিপবোর্ডে, কম্পিউটারে, নাকি কীবোর্ড দিয়ে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual campo de qual item foi para onde, e quando — para a área de transferência, para um computador ou pelo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое поле какой записи, куда и когда отправлялось — в буфер обмена, на компьютер или через клавиатуру."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کس اندراج کی کون سی فیلڈ کہاں اور کب گئی — کلپ بورڈ میں، کمپیوٹر میں، یا کی بورڈ کے ذریعے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom mana dari entri mana yang pergi ke mana, dan kapan — ke papan klip, ke komputer, atau lewat keyboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Feld welches Eintrags wohin und wann gegangen ist — in die Zwischenablage, an einen Computer oder über die Tastatur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアイテムのどのフィールドが、いつ、どこへ送られたか — クリップボード、コンピューター、またはキーボード経由。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Which field of which entry go where, and when — to clipboard, to computer, or through keyboard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường nào của mục nào đã đi đâu, và khi nào — vào bộ nhớ tạm, vào máy tính, hoặc qua bàn phím."
          }
        }
      }
    },
