    "settings_backup_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup file is encrypted with AES-256 and opens only with the backup password. You can save the file anywhere you like — Drive, SD card and so on; even if the phone is wiped, the file plus the password restores everything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek dosyası AES-256 ile şifrelenir ve yalnızca yedek parolasıyla açılır. Dosyayı Drive, SD kart vb. istediğin yere kaydedebilirsin; telefon sıfırlansa bile dosya + parola ile her şey geri yüklenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de copia se cifra con AES-256 y solo se abre con la contraseña de copia. Puedes guardarlo donde quieras — Drive, tarjeta SD, etc.; aunque el teléfono se borre por completo, el archivo más la contraseña lo restauran todo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप फ़ाइल AES-256 से एन्क्रिप्टेड है और केवल बैकअप पासवर्ड से खुलती है। इसे जहाँ चाहें रख सकते हैं — Drive, SD कार्ड वगैरह; फ़ोन पूरी तरह मिट भी जाए, तो फ़ाइल और पासवर्ड मिलकर सब कुछ लौटा देते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف النسخة الاحتياطية مشفَّر بـ AES-256 ولا يُفتح إلا بكلمة مرور النسخة. يمكنك حفظه أينما شئت — Drive، بطاقة SD وغيرها؛ حتى لو مُحي الهاتف بالكامل، يعيد الملف مع كلمة المرور كل شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份文件使用 AES-256 加密，仅能用备份密码打开。你可以将其保存在任何地方 — 网盘、SD 卡等；即使手机被清空，文件加上密码也能恢复一切。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de sauvegarde est chiffré avec AES-256 et ne s'ouvre qu'avec le mot de passe de sauvegarde. Tu peux l'enregistrer où tu veux — Drive, carte SD, etc. ; même si le téléphone est effacé, le fichier plus le mot de passe restaurent tout."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ ফাইলটি AES-256 দিয়ে এনক্রিপ্ট করা এবং শুধু ব্যাকআপ পাসওয়ার্ড দিয়ে খোলে। আপনি যেকোনো জায়গায় ফাইলটি রাখতে পারেন — ড্রাইভ, SD কার্ড ইত্যাদি; ফোন মুছে গেলেও ফাইল আর পাসওয়ার্ড দিয়ে সব ফিরে আসে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de backup é criptografado com AES-256 e só abre com a senha de backup. Você pode salvá-lo onde quiser — Drive, cartão SD e assim por diante; mesmo que o telefone seja apagado, o arquivo mais a senha restauram tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл резервной копии зашифрован AES-256 и открывается только паролем резервной копии. Вы можете сохранить его где угодно — на Диске, SD-карте и так далее; даже если телефон будет очищен, файл вместе с паролем восстановят всё."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ فائل AES-256 سے مرمز ہوتی ہے اور صرف بیک اپ پاس ورڈ سے کھلتی ہے۔ آپ اسے جہاں چاہیں محفوظ کر سکتے ہیں — Drive، SD کارڈ وغیرہ؛ فون مکمل طور پر مٹا دیا جائے تو بھی، فائل اور پاس ورڈ مل کر سب کچھ بحال کر دیتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File cadangan dienkripsi dengan AES-256 dan hanya bisa dibuka dengan kata sandi cadangan. Kamu bisa menyimpannya di mana saja — Drive, kartu SD, dll.; bahkan jika ponsel dihapus total, file dan kata sandi bersama-sama memulihkan semuanya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Backup-Datei ist mit AES-256 verschlüsselt und lässt sich nur mit dem Backup-Passwort öffnen. Du kannst sie beliebig speichern — Drive, SD-Karte usw.; selbst wenn das Telefon komplett gelöscht wird, stellen die Datei und das Passwort zusammen alles wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップファイルはAES-256で暗号化され、バックアップパスワードでのみ開くことができます。Drive、SDカードなど好きな場所に保存できます。端末を完全に消去しても、ファイルとパスワードがあればすべて復元できます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup file dey encrypted with AES-256 and na only backup password fit open am. You fit save am anywhere — Drive, SD card, and so on; even if dem wipe the phone completely, the file with the password go restore everything."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp sao lưu được mã hóa bằng AES-256 và chỉ mở được bằng mật khẩu sao lưu. Bạn có thể lưu nó ở bất kỳ đâu — Drive, thẻ SD, v.v.; ngay cả khi điện thoại bị xóa hoàn toàn, tệp cùng với mật khẩu sẽ khôi phục mọi thứ."
          }
        }
      }
    },
