    "bt_layout_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer interprets the key codes — if you pick the wrong layout, characters like @ \" ? SILENTLY turn into other ones."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş kodlarını bilgisayar yorumlar — yanlış düzen seçersen @ \" ? gibi karakterler SESSİZCE başka karaktere dönüşür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador interpreta los códigos de tecla — si eliges la distribución equivocada, caracteres como @ \" ? se convierten en silencio en otros."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "की-कोड कंप्यूटर पढ़ता है — ग़लत लेआउट चुनने पर @ \" ? जैसे अक्षर चुपचाप दूसरे में बदल जाते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحاسوب هو من يفسّر رموز المفاتيح — اختيار تخطيط خاطئ يحوّل بصمت محارف مثل @ \" ? إلى غيرها."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键代码由电脑解释 — 如果选错布局，@ \" ? 等字符会被悄悄替换成别的字符。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur interprète les codes de touche — si tu choisis la mauvaise disposition, des caractères comme @ \" ? se transforment silencieusement en d'autres."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী-কোডগুলো কম্পিউটার নিজের মতো বুঝে নেয় — ভুল লেআউট বেছে নিলে @ \" ? এর মতো অক্ষর নিঃশব্দে অন্য অক্ষরে বদলে যায়।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador interpreta os códigos de tecla — se você escolher o layout errado, caracteres como @ \" ? viram outros silenciosamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер сам интерпретирует коды клавиш — если вы выберете неверную раскладку, такие символы, как @ \" ?, незаметно превратятся в другие."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر خود کی کوڈز کی تشریح کرتا ہے — غلط لے آؤٹ منتخب کرنے سے @ \" ? جیسے حروف خاموشی سے کچھ اور بن جاتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer yang menafsirkan kode tombol — memilih tata letak yang salah mengubah karakter seperti @ \" ? menjadi karakter lain tanpa disadari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer interpretiert die Tastencodes selbst — wählst du das falsche Layout, verwandeln sich Zeichen wie @ \" ? unbemerkt in andere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーコードを解釈するのはコンピューター側です — レイアウトを間違えると、@ \" ? のような文字が気づかないうちに別の文字に変わってしまいます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Na the computer dey interpret the key codes — if you choose wrong layout, character like @ \" ? go quietly turn to something else."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính là bên diễn giải mã phím — nếu bạn chọn sai bố cục, các ký tự như @ \" ? sẽ âm thầm biến thành ký tự khác."
          }
        }
      }
    },
    "bt_no_bonded_devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices yet. Settings → Bluetooth setup wizard walks you through pairing step by step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşleşmiş cihaz yok. Ayarlar → Bluetooth kurulum sihirbazı eşleştirmeyi adım adım yaptırır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay dispositivos emparejados. Ajustes → Asistente de configuración de Bluetooth te guía paso a paso por el emparejamiento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई पेयर किया डिवाइस नहीं। सेटिंग्स → ब्लूटूथ सेटअप विज़ार्ड पेयरिंग में चरण-दर-चरण आपका मार्गदर्शन करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أجهزة مقترنة بعد. الإعدادات ← معالج إعداد البلوتوث يرشدك خلال الاقتران خطوة بخطوة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已配对的设备。设置 → 蓝牙设置向导会一步步引导你完成配对。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil appairé pour l'instant. Paramètres → Assistant de configuration Bluetooth t'accompagne pas à pas dans l'appairage."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো জোড়া লাগানো ডিভাইস নেই। সেটিংস → ব্লুটুথ সেটআপ উইজার্ড ধাপে ধাপে আপনাকে জোড়া লাগানোর পথ দেখাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dispositivos pareados. Configurações → Assistente de configuração do Bluetooth guia você pelo pareamento passo a passo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопряжённых устройств пока нет. Настройки → Мастер настройки Bluetooth проведёт вас через сопряжение шаг за шагом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی جوڑا شدہ ڈیوائس نہیں۔ سیٹنگز ← بلوٹوتھ سیٹ اپ ویزرڈ مرحلہ وار جوڑا بنانے میں آپ کی رہنمائی کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perangkat yang dipasangkan. Pengaturan → Wizard penyiapan Bluetooth memandumu melakukan pemasangan langkah demi langkah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine gekoppelten Geräte. Einstellungen → Bluetooth-Einrichtungsassistent führt dich Schritt für Schritt durch die Kopplung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みの端末はまだありません。設定 → Bluetoothセットアップウィザードが、ペアリングの手順を一つずつ案内します。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "No device wey pair dey yet. Settings → Bluetooth setup wizard go carry you through the pairing, step by step."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thiết bị nào được ghép nối. Cài đặt → Trình hướng dẫn thiết lập Bluetooth sẽ dẫn bạn qua từng bước ghép nối."
          }
        }
      }
    },
    "bt_no_computers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No computers among the paired devices. Show all devices below, or star the one you use."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmiş cihazlar arasında bilgisayar yok. Aşağıdan tüm cihazları göster ya da kullandığını yıldızla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún ordenador entre los dispositivos emparejados. Muestra todos los dispositivos abajo o marca con una estrella el que usas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयर किए डिवाइसों में कोई कंप्यूटर नहीं है। नीचे सभी डिवाइस दिखाएँ, या जिसे आप इस्तेमाल करते हैं उस पर स्टार लगाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حاسوب بين الأجهزة المقترنة. اعرض كل الأجهزة أدناه، أو ضع نجمة على الجهاز الذي تستخدمه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备中没有电脑。可在下方显示所有设备，或为你使用的设备加星标。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun ordinateur parmi les appareils appairés. Affiche tous les appareils ci-dessous, ou mets une étoile sur celui que tu utilises."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জোড়া লাগানো ডিভাইসগুলোর মধ্যে কোনো কম্পিউটার নেই। নিচে সব ডিভাইস দেখান, অথবা যেটি ব্যবহার করেন সেটিতে তারা চিহ্ন দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum computador entre os dispositivos pareados. Mostre todos os dispositivos abaixo ou marque com estrela o que você usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди сопряжённых устройств нет компьютеров. Покажите все устройства ниже или отметьте звёздочкой то, которым пользуетесь."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوڑا شدہ ڈیوائسز میں کوئی کمپیوٹر نہیں۔ نیچے تمام ڈیوائسز دکھائیں، یا جو آپ استعمال کرتے ہیں اسے ستارہ لگائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada komputer di antara perangkat yang dipasangkan. Tampilkan semua perangkat di bawah, atau beri bintang pada yang kamu pakai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter den gekoppelten Geräten ist kein Computer. Zeige unten alle Geräte an oder markiere das Gerät, das du nutzt, mit einem Stern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みの端末にコンピューターがありません。下からすべての端末を表示するか、使用する端末にスターを付けてください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "No computer dey among the device wey pair. Show all device for down, or star the one wey you dey use."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có máy tính nào trong số các thiết bị đã ghép nối. Hãy hiện tất cả thiết bị bên dưới, hoặc gắn sao cho thiết bị bạn dùng."
          }
        }
      }
    },
