          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que el ordenador se empareje…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर से पेयरिंग का इंतज़ार हो रहा है…"
          }
        },
        "ar": {
          "stringUnit": {
