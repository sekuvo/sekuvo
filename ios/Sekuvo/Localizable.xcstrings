    "guide_s2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account/Password, Everyday (name, phone, email, address), Card, and Secure note — with subtypes for scripts, keys, recovery codes and config files. Account and Everyday entries also take unlimited custom fields, encrypted just like the built-in ones."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap/Şifre, Gündelik (ad, telefon, e-posta, adres), Kart ve Güvenli not — betik, anahtar, kurtarma kodu ve yapılandırma alt türleriyle. Hesap ve Gündelik kayıtları ayrıca sınırsız ek alan kabul eder; onlar da yerleşik alanlar gibi şifrelenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta/Contraseña, Cotidiano (nombre, teléfono, correo, dirección), Tarjeta y Nota segura — con subtipos para scripts, claves, códigos de recuperación y archivos de configuración. Las entradas de Cuenta y Cotidiano admiten además campos personalizados ilimitados, cifrados igual que los integrados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता/पासवर्ड, रोज़मर्रा (नाम, फ़ोन, ईमेल, पता), कार्ड, और सुरक्षित नोट — स्क्रिप्ट, कुंजी, रिकवरी कोड और कॉन्फ़िग फ़ाइलों के उप-प्रकारों के साथ। खाता और रोज़मर्रा एंट्री में असीमित अपने बनाए फ़ील्ड भी जुड़ते हैं, अंतर्निहित फ़ील्ड जितने ही एन्क्रिप्टेड।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب/كلمة مرور، يوميّ (اسم، هاتف، بريد، عنوان)، بطاقة، وملاحظة آمنة — مع أنواع فرعية للنصوص البرمجية والمفاتيح ورموز الاستعادة وملفات الإعداد. كما تقبل مدخلات حساب ويوميّ حقولًا مخصّصة غير محدودة، مشفَّرة تمامًا كالحقول المدمجة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号/密码、日常信息（姓名、电话、邮箱、地址）、银行卡，以及安全笔记 — 笔记还分脚本、密钥、恢复代码和配置文件等子类型。账号和日常信息条目还支持无限量的自定义字段，加密方式与内置字段完全相同。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte/Mot de passe, Quotidien (nom, téléphone, e-mail, adresse), Carte, et Note sécurisée — avec des sous-types pour les scripts, clés, codes de récupération et fichiers de configuration. Les entrées Compte et Quotidien acceptent aussi des champs personnalisés illimités, chiffrés exactement comme les champs intégrés."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট/পাসওয়ার্ড, দৈনন্দিন (নাম, ফোন, ইমেইল, ঠিকানা), কার্ড, এবং নিরাপদ নোট — স্ক্রিপ্ট, কী, পুনরুদ্ধার কোড এবং কনফিগারেশন ফাইলের জন্য উপ-প্রকারসহ। অ্যাকাউন্ট ও দৈনন্দিন এন্ট্রি অসীম কাস্টম ফিল্ডও নেয়, যেগুলো বিল্ট-ইন ফিল্ডের মতোই এনক্রিপ্ট করা।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta/Senha, Dia a dia (nome, telefone, e-mail, endereço), Cartão e Nota segura — com subtipos para scripts, chaves, códigos de recuperação e arquivos de configuração. Itens de Conta e Dia a dia também aceitam campos personalizados ilimitados, criptografados exatamente como os integrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт/пароль, повседневное (имя, телефон, эл. почта, адрес), карта и защищённая заметка — с подтипами для скриптов, ключей, кодов восстановления и файлов конфигурации. Записи типа «Аккаунт» и «Повседневное» также принимают неограниченное число пользовательских полей, зашифрованных так же, как встроенные."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ/پاس ورڈ، روزمرہ (نام، فون، ای میل، پتہ)، کارڈ، اور محفوظ نوٹ — اسکرپٹس، کلیدوں، بازیابی کوڈز، اور کنفیگ فائلوں کے لیے ذیلی اقسام کے ساتھ۔ اکاؤنٹ اور روزمرہ اندراجات لامحدود اپنی مرضی کی فیلڈز بھی قبول کرتے ہیں، بالکل اسی طرح مرمز جیسے بلٹ ان فیلڈز۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun/Kata sandi, Sehari-hari (nama, telepon, email, alamat), Kartu, dan Catatan aman — dengan subjenis untuk skrip, kunci, kode pemulihan, dan file konfigurasi. Entri Akun dan Sehari-hari juga menerima kolom kustom tanpa batas, dienkripsi persis seperti kolom bawaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto/Passwort, Alltag (Name, Telefon, E-Mail, Adresse), Karte und sichere Notiz — mit Unterarten für Skripte, Schlüssel, Wiederherstellungscodes und Konfigurationsdateien. Konto- und Alltag-Einträge akzeptieren außerdem unbegrenzt viele benutzerdefinierte Felder, verschlüsselt genau wie die integrierten Felder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント/パスワード、日常（氏名、電話番号、メール、住所）、カード、セキュアメモ — スクリプト、鍵、復旧コード、設定ファイル用のサブタイプ付き。アカウントと日常のアイテムは、無制限のカスタムフィールドも受け付け、組み込みフィールドとまったく同様に暗号化されます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Account/Password, Everyday (name, phone, email, address), Card, and Secure note — with subtypes for scripts, keys, recovery codes, and config files. Account and Everyday entries fit also take unlimited custom fields, wey dem encrypt exactly like the built-in ones."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản/Mật khẩu, Hằng ngày (tên, điện thoại, email, địa chỉ), Thẻ, và Ghi chú bảo mật — với các loại phụ dành cho tập lệnh, khóa, mã khôi phục, và tệp cấu hình. Các mục Tài khoản và Hằng ngày cũng chấp nhận số lượng không giới hạn các trường tùy chỉnh, được mã hóa hoàn toàn giống như các trường tích hợp sẵn."
          }
        }
      }
    },
    "guide_s2_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you can store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neleri saklayabilirsin"
          }
        },
        "es": {
