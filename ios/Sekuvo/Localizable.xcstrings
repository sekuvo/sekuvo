    "home_empty_vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault is ready — add your first entry with the + at the bottom right."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa hazır — ilk kaydını sağ alttaki + ile ekle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bóveda está lista — añade tu primera entrada con el + de abajo a la derecha."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी तिजोरी तैयार है — नीचे दाईं ओर + से अपनी पहली एंट्री जोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزنتك جاهزة — أضف أول مدخلاتك بالضغط على + أسفل اليمين."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密码库已就绪 — 点击右下角的 + 添加第一个条目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coffre est prêt — ajoute ta première entrée avec le + en bas à droite."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভল্ট প্রস্তুত — নিচে ডানদিকের + দিয়ে প্রথম এন্ট্রিটি যোগ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cofre está pronto — adicione o primeiro item com o + no canto inferior direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше хранилище готово — добавьте первую запись кнопкой + внизу справа."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا والٹ تیار ہے — نیچے دائیں طرف + دبا کر پہلا اندراج شامل کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankasmu siap — tambahkan entri pertama dengan tombol + di kanan bawah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tresor ist bereit — füge deinen ersten Eintrag mit + unten rechts hinzu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の準備ができました — 右下の+で最初のアイテムを追加してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault don ready — add your first entry with the + wey dey bottom right."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ của bạn đã sẵn sàng — hãy thêm mục đầu tiên bằng nút + ở góc dưới bên phải."
          }
        }
      }
    },
