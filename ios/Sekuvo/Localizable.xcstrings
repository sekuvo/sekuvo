    "edit_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" will be permanently deleted. Are you sure?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" kalıcı olarak silinecek. Emin misin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se eliminará de forma permanente. ¿Seguro?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» हमेशा के लिए मिटा दी जाएगी। पक्का?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف «%1$@» نهائيًا. هل أنت متأكد؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”将被永久删除，确定吗？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » sera supprimé définitivement. Es-tu sûr ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” স্থায়ীভাবে মুছে যাবে। নিশ্চিত?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” será excluído permanentemente. Tem certeza?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» будет удалено безвозвратно. Вы уверены?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ہمیشہ کے لیے حذف ہو جائے گا۔ کیا آپ کو یقین ہے؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” akan dihapus secara permanen. Yakin?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird dauerhaft gelöscht. Bist du sicher?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は完全に削除されます。よろしいですか？"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” go delete finish finish. You sure?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sẽ bị xóa vĩnh viễn. Bạn có chắc không?"
          }
        }
      }
    },
