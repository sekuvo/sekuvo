    "unlock_restore_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First set a master password for this device. Right after, you will pick your backup file and enter its backup password; everything in the backup comes back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu cihaz için bir ana parola belirle. Hemen ardından yedek dosyanı seçip yedek parolasını gireceksin; yedekteki her şey geri gelir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero define una contraseña maestra para este dispositivo. Justo después, elegirás tu archivo de copia e introducirás su contraseña; todo lo de la copia vuelve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इस डिवाइस के लिए मास्टर पासवर्ड सेट करें। उसके तुरंत बाद अपनी बैकअप फ़ाइल चुनकर उसका बैकअप पासवर्ड डालेंगे; बैकअप की हर चीज़ वापस आ जाएगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد أولًا كلمة مرور رئيسية لهذا الجهاز. بعدها مباشرة، ستختار ملف نسختك الاحتياطية وتُدخل كلمة مرورها؛ تعود كل محتويات النسخة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先为此设备设置主密码。之后会立即让你选择备份文件并输入其备份密码；备份中的一切都将恢复。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis d'abord un mot de passe principal pour cet appareil. Juste après, tu choisiras ton fichier de sauvegarde et saisiras son mot de passe ; tout ce qu'il contient revient."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে এই ডিভাইসের জন্য একটি মূল পাসওয়ার্ড সেট করুন। এর ঠিক পরে, আপনি ব্যাকআপ ফাইল বেছে নিয়ে এর পাসওয়ার্ড দেবেন; ব্যাকআপের সবকিছু ফিরে আসবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro defina uma senha principal para este dispositivo. Logo depois, você escolherá seu arquivo de backup e digitará a senha dele; tudo o que está no backup volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала задайте основной пароль для этого устройства. Сразу после этого вы выберете файл резервной копии и введёте его пароль; всё содержимое копии вернётся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اس ڈیوائس کے لیے ماسٹر پاس ورڈ سیٹ کریں۔ اس کے فوراً بعد، آپ اپنی بیک اپ فائل منتخب کریں گے اور اس کا پاس ورڈ درج کریں گے؛ بیک اپ کا تمام مواد واپس آ جائے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur dulu kata sandi utama untuk perangkat ini. Setelah itu, kamu akan memilih file cadangan dan memasukkan kata sandinya; seluruh isinya akan kembali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege zuerst ein Hauptpasswort für dieses Gerät fest. Direkt danach wählst du deine Backup-Datei aus und gibst ihr Passwort ein; der gesamte Inhalt kehrt zurück."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこの端末のマスターパスワードを設定してください。その直後にバックアップファイルを選択してパスワードを入力すると、すべての内容が復元されます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "First set master password for dis device. Right after dat, you go choose your backup file and enter the password; everything wey dey inside am go come back."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên hãy thiết lập mật khẩu chính cho thiết bị này. Ngay sau đó, bạn sẽ chọn tệp sao lưu của mình và nhập mật khẩu của nó; toàn bộ nội dung sẽ quay trở lại."
          }
        }
      }
    },
    "unlock_restore_selected": {
      "extractionState": "manual",
      "localizations": {
