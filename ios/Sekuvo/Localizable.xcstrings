    "settings_language_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the app language. It applies to Sekuvo only, not the rest of the phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın dilini seç. Yalnız Sekuvo için geçerlidir, telefonun geri kalanını değiştirmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma de la aplicación. Se aplica solo a Sekuvo, no al resto del teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की भाषा चुनें। यह केवल Sekuvo पर लागू होती है, फ़ोन के बाक़ी हिस्से पर नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغة التطبيق. تُطبَّق على Sekuvo فقط، لا على بقية الهاتف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择应用语言，仅对 Sekuvo 生效，不影响手机的其他部分。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis la langue de l'application. Cela s'applique uniquement à Sekuvo, pas au reste du téléphone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের ভাষা বেছে নিন। এটি শুধু Sekuvo-তে প্রযোজ্য, ফোনের বাকি অংশে নয়।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o idioma do aplicativo. Isso se aplica apenas ao Sekuvo, não ao resto do telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык приложения. Он применяется только к Sekuvo, а не ко всему телефону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کی زبان منتخب کریں۔ یہ صرف Sekuvo پر لاگو ہوتی ہے، پورے فون پر نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa aplikasi. Ini hanya berlaku untuk Sekuvo, bukan seluruh ponsel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache der App. Dies gilt nur für Sekuvo, nicht für das restliche Telefon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語を選択してください。これはSekuvoにのみ適用され、端末全体には影響しません。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the app language. E go apply to Sekuvo only, e no go affect the rest of the phone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ của ứng dụng. Điều này chỉ áp dụng cho Sekuvo, không áp dụng cho phần còn lại của điện thoại."
          }
        }
      }
    },
