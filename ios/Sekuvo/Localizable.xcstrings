    "setup_pair_step3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this screen open, click your phone's name on the computer. If the same code appears on both screens, confirm on BOTH sides."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran açıkken bilgisayarda telefonunun adına tıkla. İki ekranda da aynı kod görünürse İKİ TARAFTA DA onayla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta pantalla abierta, haz clic en el nombre de tu teléfono en el ordenador. Si aparece el mismo código en las dos pantallas, confirma en AMBOS lados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्क्रीन खुली रखते हुए कंप्यूटर पर अपने फ़ोन के नाम पर क्लिक करें। अगर दोनों स्क्रीन पर एक ही कोड दिखे, तो दोनों तरफ़ ज़रूर पुष्टि करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ هذه الشاشة مفتوحة وانقر على اسم هاتفك في الحاسوب. إن ظهر الرمز نفسه على الشاشتين، فأكّده على الطرفين كليهما."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此界面打开，在电脑上点击你的手机名称。如果两个屏幕上出现相同的代码，请在双方都进行确认。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde cet écran ouvert et clique sur le nom de ton téléphone sur l'ordinateur. Si le même code s'affiche sur les deux écrans, confirme des DEUX côtés."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্ক্রিনটি খোলা রেখে কম্পিউটারে আপনার ফোনের নামে ক্লিক করুন। দুই স্ক্রিনেই একই কোড দেখা গেলে, দুই পাশেই নিশ্চিত করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esta tela aberta, clique no nome do seu telefone no computador. Se o mesmo código aparecer nas duas telas, confirme nos DOIS lados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывая этот экран, нажмите на имя вашего телефона на компьютере. Если на обоих экранах появится одинаковый код, подтвердите его с ОБЕИХ сторон."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اسکرین کھلی رکھتے ہوئے کمپیوٹر پر اپنے فون کے نام پر کلک کریں۔ اگر دونوں اسکرینوں پر ایک ہی کوڈ ظاہر ہو تو دونوں طرف تصدیق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan layar ini tetap terbuka, klik nama ponselmu di komputer. Jika kode yang sama muncul di kedua layar, konfirmasi di KEDUA sisi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass diesen Bildschirm geöffnet und klicke am Computer auf den Namen deines Telefons. Wenn auf beiden Bildschirmen derselbe Code erscheint, bestätige auf BEIDEN Seiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を開いたまま、コンピューターで端末の名前をクリックしてください。両方の画面に同じコードが表示されたら、必ず両方で確認してください。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "With dis screen open, click your phone name for the computer. If the same code show for both screens, confirm am for BOTH sides."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ màn hình này mở và nhấp vào tên điện thoại của bạn trên máy tính. Nếu cùng một mã hiện trên cả hai màn hình, hãy xác nhận ở CẢ HAI phía."
          }
        }
      }
    },
