    "detail_quick_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only while the vault is unlocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kasa kilidi açıkken kullanılabilir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible solo con la bóveda desbloqueada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तिजोरी अनलॉक रहते उपलब्ध।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاحة فقط مع فتح قفل الخزنة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在密码库解锁时可用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement quand le coffre est déverrouillé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভল্ট আনলক থাকলে পাওয়া যাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível apenas com o cofre desbloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только при разблокированном хранилище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف والٹ کا تالا کھلا ہونے پر دستیاب ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tersedia saat brankas tidak terkunci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verfügbar, wenn der Tresor entsperrt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のロックが解除されているときのみ利用できます。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey available only when the vault no dey lock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khả dụng khi kho lưu trữ đã mở khóa."
          }
        }
      }
    },
    "detail_quick_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears in the Sekuvo Keyboard even while the vault is locked; its protection is only as strong as your phone's screen lock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa kilitliyken de Sekuvo Klavyesi'nde çıkar; koruması telefonun ekran kilidi kadardır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en el Teclado Sekuvo incluso con la bóveda bloqueada; su protección es solo tan fuerte como el bloqueo de pantalla de tu teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी लॉक रहते भी Sekuvo कीबोर्ड में दिखती है; इसकी सुरक्षा उतनी ही है जितना आपके फ़ोन का स्क्रीन लॉक।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر في لوحة مفاتيح Sekuvo حتى مع قفل الخزنة؛ حمايتها بقوة قفل شاشة هاتفك فقط."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使密码库锁定时也会显示在 Sekuvo 键盘中；其保护强度仅相当于手机的锁屏。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît dans le Clavier Sekuvo même quand le coffre est verrouillé ; sa protection vaut alors celle du verrouillage d'écran de ton téléphone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট লক থাকলেও Sekuvo কীবোর্ডে দেখা যাবে; এর সুরক্ষা শুধু ফোনের স্ক্রিন লক যতটা শক্তিশালী।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no Teclado Sekuvo mesmo com o cofre bloqueado; sua proteção é tão forte quanto o bloqueio de tela do telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в Клавиатуре Sekuvo даже при заблокированном хранилище; его защита равна только блокировке экрана телефона."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ مقفل ہونے پر بھی Sekuvo کی بورڈ میں ظاہر ہوتا ہے؛ اس کی حفاظت صرف آپ کے فون کے اسکرین لاک جتنی مضبوط ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul di Keyboard Sekuvo bahkan saat brankas terkunci; perlindungannya hanya sekuat kunci layar ponselmu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in der Sekuvo-Tastatur, auch wenn der Tresor gesperrt ist; sein Schutz entspricht dann nur der Bildschirmsperre deines Telefons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫がロックされていてもSekuvoキーボードに表示されます。この場合、保護レベルは端末の画面ロックと同等になります。"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey show for Sekuvo Keyboard even if the vault dey lock; the protection wey e get na only your phone lock screen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất hiện trong Bàn phím Sekuvo ngay cả khi kho lưu trữ đang khóa; mức bảo vệ khi đó chỉ tương đương với khóa màn hình điện thoại của bạn."
          }
        }
      }
    },
