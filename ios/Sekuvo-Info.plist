<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Xcode'un ürettiği Info.plist'e eklenen anahtarlar (GENERATE_INFOPLIST_FILE
  açık; bu dosya onunla birleşir). Yalnız INFOPLIST_KEY_ ile yazılamayan
  diziler burada: .vaultbak dosya türü ve "Sekuvo ile aç".
  Dosya bilerek Sekuvo/ klasörünün dışında: o klasör kaynak olarak kopyalanır.
-->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sekuvo.vaultbak</string>
			<key>UTTypeDescription</key>
			<string>Sekuvo backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vaultbak</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Sekuvo backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.sekuvo.vaultbak</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
